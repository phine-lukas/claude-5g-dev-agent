# Downloaded 3GPP archives are never committed (copyright + size); the
# converted Markdown under specs/<id>/<version>/ is.
specs/**/raw/
*.zip
*.docx
*.doc

# Python
__pycache__/
*.pyc

# Agent status line (drives notifications; per-session state)
.agent-status

# Scratch space used by the spec converter
build-tmp/

# IDE
.idea/
