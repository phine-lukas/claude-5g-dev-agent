From b4a79b91cfe58f39b2d0b6c5cfd8a014b0dda5ed Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 12:18:33 +0000
Subject: [PATCH 1/3] fix(nas): make the ENCODE macros single statements

ENCODE_U8/U16/U32 expanded to two statements without a do/while(0) wrapper,
so at an unbraced conditional call site only the store was guarded while the
`size +=` always ran. The encoder then reported more octets than it wrote and
left the skipped octets uninitialised in the buffer.

QosRule::Encode() hit this twice: a "delete existing QoS rule" has neither a
precedence nor a QFI octet, yet it returned 6 instead of 4, which made the
QoS rules IE claim two octets more than it encoded and pushed the QoS flow
descriptions IE out of the message buffer.

Wrap the macros and brace the three unbraced call sites in the tree
(QosRule twice, _5gsNetworkFeatureSupport once).

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PR4cGxt4Ymr7NtUQWN3MP1
---
 common/common_defs.h                  | 18 ++++++++++++------
 nas/ies/QosRule.cpp                   |  6 ++++--
 nas/ies/_5gsNetworkFeatureSupport.cpp |  3 ++-
 3 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/common/common_defs.h b/common/common_defs.h
index cfc00b30..0e1e0db2 100644
--- a/common/common_defs.h
+++ b/common/common_defs.h
@@ -78,12 +78,16 @@ typedef enum {
 #endif
 
 #define ENCODE_U8(buffer, value, size)                                         \
-  *(uint8_t*) (buffer) = value;                                                \
-  size += sizeof(uint8_t)
+  do {                                                                         \
+    *(uint8_t*) (buffer) = value;                                              \
+    size += sizeof(uint8_t);                                                   \
+  } while (0)
 
 #define ENCODE_U16(buffer, value, size)                                        \
-  *(uint16_t*) (buffer) = htons(value);                                        \
-  size += sizeof(uint16_t)
+  do {                                                                         \
+    *(uint16_t*) (buffer) = htons(value);                                      \
+    size += sizeof(uint16_t);                                                  \
+  } while (0)
 
 #define ENCODE_U24(buffer, value, size)                                        \
   do {                                                                         \
@@ -94,8 +98,10 @@ typedef enum {
   } while (0)
 
 #define ENCODE_U32(buffer, value, size)                                        \
-  *(uint32_t*) (buffer) = htonl(value);                                        \
-  size += sizeof(uint32_t)
+  do {                                                                         \
+    *(uint32_t*) (buffer) = htonl(value);                                      \
+    size += sizeof(uint32_t);                                                  \
+  } while (0)
 
 ////////////
 #define IPV4_STR_ADDR_TO_INADDR(AdDr_StR, InAdDr, MeSsAgE)                     \
diff --git a/nas/ies/QosRule.cpp b/nas/ies/QosRule.cpp
index 4389b372..1f36fffe 100644
--- a/nas/ies/QosRule.cpp
+++ b/nas/ies/QosRule.cpp
@@ -284,15 +284,17 @@ int QosRule::Encode(uint8_t* buf, int len) const {
   }
 
   // Precedence
-  if (precedence_.has_value())
+  if (precedence_.has_value()) {
     ENCODE_U8(buf + encoded_size, precedence_.value(), encoded_size);
+  }
   // Segregation + QFI
   uint8_t octet_segregation_qfi = {};
   if (segregation_) octet_segregation_qfi = 0b01000000;
   if (qfi_.has_value())
     octet_segregation_qfi = octet_segregation_qfi | (qfi_.value() & 0x03f);
-  if (segregation_ or qfi_.has_value())
+  if (segregation_ or qfi_.has_value()) {
     ENCODE_U8(buf + encoded_size, octet_segregation_qfi, encoded_size);
+  }
 
   oai::logger::logger_common::nas().debug(
       "Encoded QosRule, len (%d)", encoded_size);
diff --git a/nas/ies/_5gsNetworkFeatureSupport.cpp b/nas/ies/_5gsNetworkFeatureSupport.cpp
index 3a287ba3..00136b06 100644
--- a/nas/ies/_5gsNetworkFeatureSupport.cpp
+++ b/nas/ies/_5gsNetworkFeatureSupport.cpp
@@ -60,8 +60,9 @@ int _5gsNetworkFeatureSupport::Encode(uint8_t* buf, int len) const {
   ENCODE_U8(buf + encoded_size, value_, encoded_size);
 
   // Octet 4
-  if (GetIeLength() > encoded_size)
+  if (GetIeLength() > encoded_size) {
     ENCODE_U8(buf + encoded_size, value2_, encoded_size);
+  }
 
   // Spare
   if (GetIeLength() > encoded_size) {

