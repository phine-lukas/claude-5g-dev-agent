From 4bb06a4924d7c720a5b70d1c1c9f460b8aa8d7e8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 13 Nov 2026 12:31:19 +0000
Subject: [PATCH 1/4] fix(smf): build spec-compliant delete QoS rules

The DELETE-operation QoS rule built for a released flow carried a QFI.
Table 9.11.4.13.1@3GPP TS 24.501 says that for the "delete existing QoS rule"
operation the QoS flow identifier value field shall not be included, and
NOTE 1 of the same table forbids that octet without the preceding precedence
octet, which a delete rule must not carry either. Drop the QFI so the rule is
the 4 octets the spec describes; the QFI still reaches the UE in the DELETE
QoS flow description beside it.

A flow with no edge yielded a rule identifier of 0, which the same table
forbids the network from sending. Release the flow without an N1 QoS rule in
that case and log it, rather than emitting a rule the UE would reject.

mark_qfi_for_release() duplicated build_release_flow() verbatim while that
function had no caller; call it instead. Also correct the citation for the
QoS Flow To Release List: it is TS 38.413 clause 9.3.1.13 (QoS Flow List with
Cause), referenced from clause 9.3.4.3, not clause 9.3.1.8.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PR4cGxt4Ymr7NtUQWN3MP1
---
 src/smf_app/session_handler.cpp | 59 +++++++++++++--------------------
 1 file changed, 23 insertions(+), 36 deletions(-)

diff --git a/src/smf_app/session_handler.cpp b/src/smf_app/session_handler.cpp
index 709db6c..b1d8b7d 100644
--- a/src/smf_app/session_handler.cpp
+++ b/src/smf_app/session_handler.cpp
@@ -104,7 +104,8 @@ void session_handler::set_qfis_to_be_updated(
 qos_flow_context_updated session_handler::build_release_flow(
     const pfcp::qfi_t& qfi) {
   // Standards: TS 24.501 §9.11.4.13 (QoS rules) / §9.11.4.12 (QoS flow
-  //            descriptions); TS 38.413 §9.3.1.8 (QoS Flow To Release List)
+  //            descriptions); TS 38.413 §9.3.1.13 (QoS Flow List with Cause,
+  //            carried as the QoS Flow To Release List of §9.3.4.3)
   qos_flow_context_updated flow = {};
   flow.qfi                      = qfi;
   flow.to_be_removed            = true;
@@ -114,14 +115,26 @@ qos_flow_context_updated session_handler::build_release_flow(
   auto edge       = get_edge_for_qfi(qfi.qfi);
   if (edge) rule_id = edge->qos_rule_id;
 
-  // N1: DELETE-operation QoS rule (no packet filters for a delete).
-  nas::QosRule rule = {};
-  rule.SetQosRuleId(rule_id);
-  rule.SetRuleOperationCode(
-      nas::kQosRuleRuleOperationCodeDeleteExistingQosRule);
-  rule.SetNumberOfPacketFilters(0);
-  rule.SetQfi(qfi.qfi);
-  flow.add_qos_rule(rule);
+  if (rule_id == NO_QOS_RULE_IDENTIFIER_ASSIGNED) {
+    // "The network shall not set the QRI value to 0"
+    // (Table 9.11.4.13.1@3GPP TS 24.501). Without an edge there is no rule
+    // identifier to delete, and a rule carrying 0 would make the UE discard
+    // the whole Modification Command. Release the flow without an N1 rule.
+    Logger::smf_app().error(
+        "No QoS rule identifier for QFI %d - releasing the flow without a "
+        "DELETE QoS rule",
+        qfi.qfi);
+  } else {
+    // N1: DELETE-operation QoS rule. Table 9.11.4.13.1@3GPP TS 24.501 requires
+    // an empty packet filter list and forbids both the precedence and the QFI
+    // value field, which makes the rule 4 octets with a length indicator of 1.
+    nas::QosRule rule = {};
+    rule.SetQosRuleId(rule_id);
+    rule.SetRuleOperationCode(
+        nas::kQosRuleRuleOperationCodeDeleteExistingQosRule);
+    rule.SetNumberOfPacketFilters(0);
+    flow.add_qos_rule(rule);
+  }
 
   // N1: DELETE-operation QoS flow description.
   nas::QosFlowDescription desc = {};
@@ -136,34 +149,8 @@ qos_flow_context_updated session_handler::build_release_flow(
 
 //------------------------------------------------------------------------------
 void session_handler::mark_qfi_for_release(const pfcp::qfi_t& qfi) {
-  qos_flow_context_updated flow = {};
-  flow.qfi                      = qfi;
-  flow.to_be_removed            = true;
-  flow.cause_value              = m_cause_value;
-
-  uint8_t rule_id = 0;
-  auto edge       = get_edge_for_qfi(qfi.qfi);
-  if (edge) rule_id = edge->qos_rule_id;
-
-  // N1: DELETE-operation QoS rule
-  nas::QosRule rule = {};
-  rule.SetQosRuleId(rule_id);
-  rule.SetRuleOperationCode(
-      nas::kQosRuleRuleOperationCodeDeleteExistingQosRule);
-  rule.SetNumberOfPacketFilters(0);
-  rule.SetQfi(qfi.qfi);
-  flow.add_qos_rule(rule);
-
-  // N1: DELETE-operation QoS flow description
-  nas::QosFlowDescription desc = {};
-  desc.SetQfi(qfi.qfi);
-  desc.SetOperationCode(
-      nas::
-          kQosFlowDescriptionRuleOperationCodeDeleteExistingQosFlowDescription);
-  flow.set_qos_flow_descriptions(desc);
-
   // Stash directly into internal state
-  m_qos_flows_to_be_released.push_back(flow);
+  m_qos_flows_to_be_released.push_back(build_release_flow(qfi));
 }
 
 //------------------------------------------------------------------------------

