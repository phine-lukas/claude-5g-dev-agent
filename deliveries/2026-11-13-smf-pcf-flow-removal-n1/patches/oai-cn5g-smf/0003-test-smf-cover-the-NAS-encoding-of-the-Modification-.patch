+/*
+ * SPDX-License-Identifier: LicenseRef-CSSL-1.0
+ */
+
+// Encoding of the NAS PDU Session Modification Command and of the QoS rules it
+// carries.
+//
+// Standards: TS 24.501 V18.14.0 clause 9.11.4.13 (QoS rules), clause 9.11.4.12
+//            (QoS flow descriptions) and clause 8.3.7 (PDU Session
+//            Modification Command).
+//
+// The smf_n1 builders themselves need the global SMF context, so these tests
+// assemble the same IEs directly and check what goes on the wire.
+
+#include <gtest/gtest.h>
+
+#include <vector>
+
+#include "IeConst.hpp"
+#include "PduSessionModificationCommand.hpp"
+#include "QosFlowDescription.hpp"
+#include "QosFlowDescriptions.hpp"
+#include "QosRule.hpp"
+#include "QosRules.hpp"
+#include "SessionAmbr.hpp"
+#include "_5gsmCause.hpp"
+#include "bstrlib.h"
+#include "common_defs.h"
+#include "3gpp_commons.h"
+
+using namespace oai::nas;
+
+namespace {
+
+// A "delete existing QoS rule", built exactly as
+// session_handler::mark_qfi_for_release() builds it.
+QosRule make_delete_rule(uint8_t rule_id) {
+  QosRule rule = {};
+  rule.SetQosRuleId(rule_id);
+  rule.SetRuleOperationCode(kQosRuleRuleOperationCodeDeleteExistingQosRule);
+  rule.SetNumberOfPacketFilters(0);
+  return rule;
+}
+
+// A "create new QoS rule" with a single match-all packet filter, precedence
+// and QFI — the shape the create path produces.
+QosRule make_create_rule(uint8_t rule_id, uint8_t qfi, uint8_t precedence) {
+  QosRule rule = {};
+  rule.SetQosRuleId(rule_id);
+  rule.SetRuleOperationCode(kQosRuleRuleOperationCodeCreateNewQosRule);
+  rule.SetNumberOfPacketFilters(1);
+
+  // A protocol-identifier filter, built the way
+  // session_handler::set_protocol_filter() builds it.
+  PacketFilterCreateAndModifyAndReplace pf = {};
+  pf.packet_filter_direction               = 0b11;  // bidirectional
+  pf.packet_filter_id                      = 1;
+  uint8_t protocol_id                      = 17;    // UDP
+  PacketFilterComponent component          = {};
+  component.type  = kQosRulePfctiProtocolIdentifierOrNextHeaderType;
+  component.value = blk2bstr(&protocol_id, 1);
+  pf.content.packet_filter_components.push_back(component);
+  pf.content.length = blength(component.value) + 1;  // +1 for the type octet
+  rule.AddPacketFilterCreateAndModifyAndReplace(pf);
+
+  rule.SetPrecedence(precedence);
+  rule.SetQfi(qfi);
+  return rule;
+}
+
+QosFlowDescription make_delete_flow_description(uint8_t qfi) {
+  QosFlowDescription desc = {};
+  desc.SetQfi(qfi);
+  desc.SetOperationCode(
+      kQosFlowDescriptionRuleOperationCodeDeleteExistingQosFlowDescription);
+  return desc;
+}
+
+SessionAmbr make_session_ambr() {
+  SessionAmbr ambr = {};
+  ambr.SetSessionAmbrForDownlink(1);
+  ambr.SetUnitForDownlink(kBitRateUnitValueIsIncrementedInMultiplesOf1Mbps);
+  ambr.SetSessionAmbrForUplink(1);
+  ambr.SetUnitForUplink(kBitRateUnitValueIsIncrementedInMultiplesOf1Mbps);
+  return ambr;
+}
+
+}  // namespace
+
+// =============================================================================
+// QoS rule encoding (TS 24.501 §9.11.4.13)
+// =============================================================================
+
+// Table 9.11.4.13.1: "For the 'delete existing QoS rule' operation, the length
+// of QoS rule field is set to one", and neither the precedence nor the QFI
+// value field shall be included. The whole rule is therefore 4 octets:
+// identifier, two length octets, and octet 7.
+TEST(NasModificationCommandTest, DeleteQosRule_IsFourOctetsWithLengthOne) {
+  const QosRule rule = make_delete_rule(3);
+
+  EXPECT_EQ(rule.GetLengthIndicator(), 1);
+  EXPECT_EQ(rule.GetIeLength(), 4);
+
+  uint8_t buffer[64] = {0};
+  const int encoded  = rule.Encode(buffer, sizeof(buffer));
+  ASSERT_EQ(encoded, 4);
+
+  EXPECT_EQ(buffer[0], 3);     // QoS rule identifier
+  EXPECT_EQ(buffer[1], 0x00);  // length of QoS rule, high octet
+  EXPECT_EQ(buffer[2], 0x01);  // length of QoS rule, low octet
+  // Octet 7: rule operation code 010 in bits 8-6, DQR 0, 0 packet filters.
+  EXPECT_EQ(buffer[3], 0x40);
+}
+
+// A delete rule must not carry a QFI: Table 9.11.4.13.1 forbids the value
+// field, and NOTE 1 forbids octet m+2 without octet m+1 (the precedence).
+TEST(NasModificationCommandTest, DeleteQosRule_CarriesNoQfiOrPrecedence) {
+  const QosRule rule = make_delete_rule(7);
+
+  EXPECT_FALSE(rule.GetQfi().has_value());
+  EXPECT_FALSE(rule.GetPrecedence().has_value());
+}
+
+// The length a rule reports and the number of octets it writes must agree, or
+// the message buffer is sized wrongly.
+TEST(NasModificationCommandTest, QosRule_EncodedSizeMatchesReportedLength) {
+  const QosRule delete_rule = make_delete_rule(3);
+  uint8_t delete_buffer[64] = {0};
+  EXPECT_EQ(
+      delete_rule.Encode(delete_buffer, sizeof(delete_buffer)),
+      static_cast<int>(delete_rule.GetIeLength()));
+
+  const QosRule create_rule = make_create_rule(1, 5, 10);
+  uint8_t create_buffer[64] = {0};
+  EXPECT_EQ(
+      create_rule.Encode(create_buffer, sizeof(create_buffer)),
+      static_cast<int>(create_rule.GetIeLength()));
+}
+
+// Encode() must not write past the end of a buffer that is too small. It
+// writes GetIeLength() octets, so that is what it has to validate against.
+TEST(NasModificationCommandTest, QosRule_RejectsABufferSmallerThanTheIe) {
+  const QosRule rule   = make_delete_rule(3);
+  const uint16_t ie_len = rule.GetIeLength();
+  ASSERT_GT(ie_len, 0);
+
+  std::vector<uint8_t> buffer(ie_len - 1, 0);
+  EXPECT_EQ(rule.Encode(buffer.data(), ie_len - 1), KEncodeDecodeError);
+}
+
+// The QoS rules IE reports header + the sum of its rules.
+TEST(NasModificationCommandTest, QosRules_AggregateLengthMatchesEncodedSize) {
+  std::vector<QosRule> rules = {make_delete_rule(3), make_delete_rule(4)};
+
+  QosRules qos_rules = {};
+  qos_rules.Set(rules);
+
+  uint8_t buffer[128] = {0};
+  const int encoded   = qos_rules.Encode(buffer, sizeof(buffer));
+  ASSERT_GT(encoded, 0);
+  EXPECT_EQ(encoded, static_cast<int>(qos_rules.GetIeLength()));
+}
+
+// =============================================================================
+// PDU Session Modification Command (TS 24.501 §8.3.7)
+// =============================================================================
+
+// The removal case: two delete rules and two delete flow descriptions. Before
+// the fix this did not encode at all, because GetLength() under-counted the
+// rules and the flow descriptions IE no longer fitted in the buffer.
+TEST(NasModificationCommandTest, ModificationCommand_DeleteCase_Encodes) {
+  PduSessionModificationCommand command = {};
+  command.SetHeader(1, 2);
+
+  _5gsmCause cause = {};
+  cause.SetValue(k5gsmCauseRegularDeactivation);
+  command.Set5gsmCause(cause);
+
+  command.SetSessionAmbr(make_session_ambr());
+
+  QosRules qos_rules         = {};
+  std::vector<QosRule> rules = {make_delete_rule(3), make_delete_rule(4)};
+  qos_rules.Set(rules);
+  command.SetAuthorizedQosRules(qos_rules);
+
+  QosFlowDescriptions descriptions                  = {};
+  std::vector<QosFlowDescription> description_list = {
+      make_delete_flow_description(5), make_delete_flow_description(9)};
+  descriptions.Set(description_list);
+  command.SetAuthorizedQosFlowDescriptions(descriptions);
+
+  const uint32_t msg_len = command.GetLength();
+  std::vector<uint8_t> buffer(msg_len, 0);
+  const int encoded = command.Encode(buffer.data(), msg_len);
+
+  ASSERT_NE(encoded, KEncodeDecodeError);
+  EXPECT_EQ(encoded, static_cast<int>(msg_len));
+}
+
+// The creation case has to keep working.
+TEST(NasModificationCommandTest, ModificationCommand_CreateCase_Encodes) {
+  PduSessionModificationCommand command = {};
+  command.SetHeader(1, 2);
+
+  _5gsmCause cause = {};
+  cause.SetValue(k5gsmCauseRegularDeactivation);
+  command.Set5gsmCause(cause);
+
+  command.SetSessionAmbr(make_session_ambr());
+
+  QosRules qos_rules         = {};
+  std::vector<QosRule> rules = {make_create_rule(1, 5, 10)};
+  qos_rules.Set(rules);
+  command.SetAuthorizedQosRules(qos_rules);
+
+  QosFlowDescription create_description = {};
+  create_description.SetQfi(5);
+  create_description.SetOperationCode(
+      kQosFlowDescriptionRuleOperationCodeCreateNewQosFlowDescription);
+  QosFlowDescriptions descriptions                 = {};
+  std::vector<QosFlowDescription> description_list = {create_description};
+  descriptions.Set(description_list);
+  command.SetAuthorizedQosFlowDescriptions(descriptions);
+
+  const uint32_t msg_len = command.GetLength();
+  std::vector<uint8_t> buffer(msg_len, 0);
+  const int encoded = command.Encode(buffer.data(), msg_len);
+
+  ASSERT_NE(encoded, KEncodeDecodeError);
+  EXPECT_EQ(encoded, static_cast<int>(msg_len));
+}
+
+// Session-AMBR, authorized QoS rules and authorized QoS flow descriptions are
+// optional IEs of the Modification Command, so each one goes on the wire
+// preceded by its IEI. Without them the UE stops at the first unknown octet.
+TEST(NasModificationCommandTest, ModificationCommand_OptionalIesCarryTheirIei) {
+  PduSessionModificationCommand command = {};
+  command.SetHeader(1, 2);
+
+  _5gsmCause cause = {};
+  cause.SetValue(k5gsmCauseRegularDeactivation);
+  command.Set5gsmCause(cause);
+
+  command.SetSessionAmbr(make_session_ambr());
+
+  QosRules qos_rules         = {};
+  std::vector<QosRule> rules = {make_delete_rule(3)};
+  qos_rules.Set(rules);
+  command.SetAuthorizedQosRules(qos_rules);
+
+  QosFlowDescriptions descriptions                 = {};
+  std::vector<QosFlowDescription> description_list = {
+      make_delete_flow_description(5)};
+  descriptions.Set(description_list);
+  command.SetAuthorizedQosFlowDescriptions(descriptions);
+
+  const uint32_t msg_len = command.GetLength();
+  std::vector<uint8_t> buffer(msg_len, 0);
+  const int encoded = command.Encode(buffer.data(), msg_len);
+  ASSERT_NE(encoded, KEncodeDecodeError);
+
+  // 4 octets of 5GSM header, then the 5GSM cause with its IEI.
+  ASSERT_GE(encoded, 6);
+  EXPECT_EQ(buffer[4], kIei5gsmCause);
+
+  // Session-AMBR follows the cause, then the QoS rules and the QoS flow
+  // descriptions, each introduced by its own IEI.
+  const uint8_t* ambr = &buffer[6];
+  EXPECT_EQ(ambr[0], kIeiSessionAmbr);
+  const uint8_t* qos_rules_ie = ambr + 1 /* IEI */ + 1 /* length */ + ambr[1];
+  EXPECT_EQ(qos_rules_ie[0], kIeiAuthorizedQosRules);
+  const uint8_t* flow_descriptions_ie =
+      qos_rules_ie + 3 /* IEI + 2 length octets */ +
+      ((qos_rules_ie[1] << 8) | qos_rules_ie[2]);
+  EXPECT_EQ(flow_descriptions_ie[0], kIeiAuthorizedQosFlowDescriptions);
+}
+
+// What the SMF encodes, the NAS library must be able to decode again. This
+// fails without the IEIs, because Decode() dispatches on them.
+TEST(NasModificationCommandTest, ModificationCommand_RoundTripsThroughDecode) {
+  PduSessionModificationCommand command = {};
+  command.SetHeader(1, 2);
+
+  _5gsmCause cause = {};
+  cause.SetValue(k5gsmCauseRegularDeactivation);
+  command.Set5gsmCause(cause);
+
+  command.SetSessionAmbr(make_session_ambr());
+
+  QosRules qos_rules         = {};
+  std::vector<QosRule> rules = {make_delete_rule(3), make_delete_rule(4)};
+  qos_rules.Set(rules);
+  command.SetAuthorizedQosRules(qos_rules);
+
+  const uint32_t msg_len = command.GetLength();
+  std::vector<uint8_t> buffer(msg_len, 0);
+  const int encoded = command.Encode(buffer.data(), msg_len);
+  ASSERT_NE(encoded, KEncodeDecodeError);
+
+  PduSessionModificationCommand decoded = {};
+  EXPECT_NE(decoded.Decode(buffer.data(), encoded), KEncodeDecodeError);
+
+  std::optional<QosRules> decoded_rules = {};
+  decoded.GetAuthorizedQosRules(decoded_rules);
+  ASSERT_TRUE(decoded_rules.has_value());
+
+  std::vector<QosRule> round_tripped = {};
+  decoded_rules.value().Get(round_tripped);
+  EXPECT_EQ(round_tripped.size(), 2u);
+}
