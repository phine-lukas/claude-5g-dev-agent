+// A session handler whose graph holds one N3 edge per QFI, each carrying a
+// QoS rule identifier, so that release builds a real DELETE QoS rule.
+std::unique_ptr<session_handler> make_session_handler_with_edges(
+    const std::vector<std::pair<uint8_t, uint8_t>>& qfi_and_rule_id) {
+  auto handler = std::make_unique<session_handler>(
+      pdu_session_type_e::PDU_SESSION_TYPE_E_IPV4);
+  auto graph = std::make_shared<upf_graph>();
+
+  oai::config::smf::upf upf_cfg("127.0.0.1", 8805, false, true, false, "");
+  auto upf = std::make_shared<pfcp_association>(upf_cfg);
+
+  for (const auto& [qfi, rule_id] : qfi_and_rule_id) {
+    auto edge     = std::make_shared<qos_upf_edge>();
+    edge->qfi.qfi = qfi;
+    edge->type.setEnumValue(UPInterfaceType_anyOf::eUPInterfaceType_anyOf::N3);
+    edge->default_qos = false;
+    edge->qos_rule_id = rule_id;
+    graph->add_qos_flow_edge(upf, edge);
+  }
+
+  handler->set_session_graph(graph);
+  return handler;
+}
+
 }  // namespace
 
 // =============================================================================
@@ -76,6 +101,60 @@ TEST(SessionHandlerTest, MarkQfiForRelease_CreatesAndStashesDeleteDescriptors) {
   EXPECT_EQ(retrieved_list[1].qfi.qfi, 9);
 }
 
+// Table 9.11.4.13.1@3GPP TS 24.501: for the "delete existing QoS rule"
+// operation the packet filter list is empty and neither the QoS rule
+// precedence nor the QoS flow identifier value field is included, which makes
+// the rule 4 octets long with a length indicator of one.
+TEST(SessionHandlerTest, MarkQfiForRelease_BuildsASpecCompliantDeleteRule) {
+  auto handler = make_session_handler_with_edges({{5, 3}});
+
+  pfcp::qfi_t target_qfi;
+  target_qfi.qfi = 5;
+  handler->mark_qfi_for_release(target_qfi);
+
+  auto retrieved_list = handler->get_qos_flows_to_be_released();
+  ASSERT_EQ(retrieved_list.size(), 1u);
+  ASSERT_EQ(retrieved_list[0].qos_rules.size(), 1u);
+
+  const auto& qos_rule = retrieved_list[0].qos_rules.begin()->second;
+  EXPECT_EQ(qos_rule.GetQosRuleId(), 3);
+  EXPECT_EQ(
+      qos_rule.GetRuleOperationCode(),
+      oai::nas::kQosRuleRuleOperationCodeDeleteExistingQosRule);
+  EXPECT_EQ(qos_rule.GetNumberOfPacketFilters(), 0);
+  EXPECT_FALSE(qos_rule.GetQfi().has_value());
+  EXPECT_FALSE(qos_rule.GetPrecedence().has_value());
+
+  EXPECT_EQ(qos_rule.GetLengthIndicator(), 1);
+  EXPECT_EQ(qos_rule.GetIeLength(), 4);
+
+  uint8_t buffer[32] = {0};
+  EXPECT_EQ(qos_rule.Encode(buffer, sizeof(buffer)), 4);
+}
+
+// "The network shall not set the QRI value to 0" (Table 9.11.4.13.1@3GPP
+// TS 24.501). Without an edge there is no rule identifier to delete, so the
+// flow is still released but carries no N1 QoS rule, rather than one the UE
+// would reject.
+TEST(SessionHandlerTest, MarkQfiForRelease_OmitsTheRuleWhenNoIdentifierExists) {
+  auto handler = make_session_handler();
+
+  pfcp::qfi_t target_qfi;
+  target_qfi.qfi = 5;
+  handler->mark_qfi_for_release(target_qfi);
+
+  auto retrieved_list = handler->get_qos_flows_to_be_released();
+  ASSERT_EQ(retrieved_list.size(), 1u);
+  EXPECT_TRUE(retrieved_list[0].to_be_removed);
+  EXPECT_TRUE(retrieved_list[0].qos_rules.empty());
+
+  // The flow description still tells the UE to delete the flow.
+  EXPECT_EQ(
+      retrieved_list[0].get_qos_flow_descriptions().GetOperationCode(),
+      oai::nas::
+          kQosFlowDescriptionRuleOperationCodeDeleteExistingQosFlowDescription);
+}
