+
+A TMGI is looked for inside the nested transfer IEs too, not only at the top
+level of the PDU: the MBS session of a per-UE PDU Session Resource Modify
+lives inside pDUSessionResourceModifyRequestTransfer, which is an OCTET STRING
+CONTAINING on the wire and so comes out of pycrate as plain bytes.
+
+ran_ue is the RAN UE NGAP ID, which is what tells one UE's procedures from
+another's -- there is nothing else in a capture that does.
 """
 
 import argparse
@@ -45,30 +53,109 @@ def ngap_payloads(path):
             chunk = chunk.payload
 
 
+def find_key(val, key):
+    """Depth-first search for the first value of `key` anywhere in a decoded PDU.
+
+    pycrate gives a SEQUENCE as a dict and a CHOICE as a (name, value) pair, and
+    an open-type IE value is a CHOICE -- so `RAN-UE-NGAP-ID` is a choice *name*,
+    not a dict key, and a search that only walks dicts never finds it.
+    """
+    if isinstance(val, dict):
+        for k, v in val.items():
+            if k == key:
+                return v
+            found = find_key(v, key)
+            if found is not None:
+                return found
+    elif isinstance(val, tuple) and len(val) == 2 and isinstance(val[0], str):
+        if val[0] == key:
+            return val[1]
+        return find_key(val[1], key)
+    elif isinstance(val, (list, tuple)):
+        for v in val:
+            found = find_key(v, key)
+            if found is not None:
+                return found
+    return None
+
+
+def decode_transfer(name, buf):
+    """Decode a nested *Transfer octet string with the pycrate type of the same name.
+
+    pycrate names an ASN.1 type exactly as the grammar does, and the IE that
+    carries a transfer is named after it with a lowercase first letter, so the
+    type is recovered from the key. Returns None when there is no such type or
+    the octets are not that type -- a transfer this script does not know about
+    is not a reason to give up on the capture.
+    """
+    from pycrate_asn1dir import NGAP
+
+    type_name = name[0].upper() + name[1:]
+    spec = getattr(NGAP.NGAP_IEs, type_name, None)
+    if spec is None:
+        return None
+    try:
+        spec.from_aper(bytes(buf))
+        return spec.get_val()
+    except Exception:
+        return None
+
+
 def find_tmgi(val):
-    """Depth-first search for a TMGI octet string anywhere in a decoded PDU."""
+    """Depth-first search for a TMGI, descending into nested transfer IEs.
+
+    The top level is searched first so a PDU that carries the TMGI directly --
+    every non-UE-associated MBS procedure does -- costs no decoding.
+    """
+    direct = find_key(val, "tMGI")
+    if isinstance(direct, (bytes, bytearray)):
+        return bytes(direct)
+    return _find_tmgi_nested(val)
+
+
+def _find_tmgi_nested(val):
     if isinstance(val, dict):
         for k, v in val.items():
-            if k == "tMGI" and isinstance(v, (bytes, bytearray)):
-                return bytes(v)
-            found = find_tmgi(v)
+            found = _try_transfer(k, v) or _find_tmgi_nested(v)
             if found is not None:
                 return found
+    elif isinstance(val, tuple) and len(val) == 2 and isinstance(val[0], str):
+        # a CHOICE: the transfer may be carried as the chosen alternative, named
+        # after the type it contains (OCTET STRING CONTAINING ...).
+        return _try_transfer(val[0], val[1]) or _find_tmgi_nested(val[1])
     elif isinstance(val, (list, tuple)):
         for v in val:
-            found = find_tmgi(v)
+            found = _find_tmgi_nested(v)
             if found is not None:
                 return found
     return None
 
 
+def _try_transfer(name, value):
+    """The TMGI inside `value`, when `name` says it is a nested transfer."""
+    if not name.endswith("Transfer") or not isinstance(value, (bytes, bytearray)):
+        return None
+    decoded = decode_transfer(name, value)
+    if decoded is None:
+        return None
+    return find_tmgi(decoded)
+
+
+def find_ran_ue_id(val):
+    """The RAN UE NGAP ID of a UE-associated PDU, or None for a non-UE-associated one."""
+    found = find_key(val, "RAN-UE-NGAP-ID")
+    return found if isinstance(found, int) else None
+
+
 def main():
     ap = argparse.ArgumentParser()
     ap.add_argument("pcap")
     ap.add_argument("--procedure-code", type=int, default=None,
                     help="only report PDUs with this procedure code")
     ap.add_argument("--summary", action="store_true",
-                    help="print one line per (kind, procedureCode, tmgi) seen")
+                    help="print one line per (kind, procedureCode, ran_ue, tmgi) seen")
+    ap.add_argument("--ran-ue", type=int, default=None,
+                    help="only report PDUs of this RAN UE NGAP ID")
     args = ap.parse_args()
 
     from pycrate_asn1dir import NGAP
@@ -87,17 +174,25 @@ def main():
         if args.procedure_code is not None and code != args.procedure_code:
             continue
         tmgi = find_tmgi(body)
-        row = (src, dst, kind, code, tmgi.hex() if tmgi else None)
+        ran_ue = find_ran_ue_id(body)
+        row = (src, dst, kind, code, tmgi.hex() if tmgi else None, ran_ue)
+        if args.ran_ue is not None and ran_ue != args.ran_ue:
+            continue
         seen.append(row)
         if not args.summary:
             line = f"{src} -> {dst}  {kind}  procedureCode={code}"
+            if ran_ue is not None:
+                line += f"  ran_ue={ran_ue}"
             if tmgi:
                 line += f"  tmgi={tmgi.hex()}"
             print(line)
 
     if args.summary:
-        for kind, code, tmgi in sorted({(r[2], r[3], r[4]) for r in seen}):
-            print(f"{kind} procedureCode={code} tmgi={tmgi}")
+        for kind, code, ran_ue, tmgi in sorted(
+                {(r[2], r[3], r[5], r[4]) for r in seen},
+                key=lambda r: (r[0], r[1] if r[1] is not None else -1,
+                               r[2] if r[2] is not None else -1, r[3] or "")):
+            print(f"{kind} procedureCode={code} ran_ue={ran_ue} tmgi={tmgi}")
 
     return 0 if seen else 1
 
