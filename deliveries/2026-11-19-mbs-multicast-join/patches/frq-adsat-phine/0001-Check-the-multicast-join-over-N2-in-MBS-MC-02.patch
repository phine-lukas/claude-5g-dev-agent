+#!/usr/bin/env python3
+"""Self-test of decode_ngap.py, run without a testbed.
+
+The runbook's MBS checks rest entirely on this decoder: if it misses a TMGI or
+attributes a procedure to the wrong UE, MBS-MC-02 is wrong in a way no amount
+of staring at the runbook would show. So the PDUs it has to read are built
+here with the same pycrate grammar, written into a capture, and decoded back.
+
+Synthetic, deliberately: a capture recorded from the testbed would pin the test
+to one run of one build, and could not express the negative case -- a UE that
+appears on N2 without any MBS procedure.
+
+    python3 tests/tools/test_decode_ngap.py
+"""
+
+import os
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+DECODER = os.path.join(HERE, "decode_ngap.py")
+
+TMGI = bytes.fromhex("abcdef99f907")
+OTHER_TMGI = bytes.fromhex("00000299f907")
+
+# ProtocolIE-IDs of TS 38.413 V17.10.0, as the gNB's own grammar numbers them.
+ID_AMF_UE_NGAP_ID = 10
+ID_RAN_UE_NGAP_ID = 85
+ID_MODIFY_LIST_REQ = 64
+ID_MODIFY_LIST_RES = 65
+ID_MBS_SESSION_ID = 299
+ID_MBS_SETUPMOD_REQ_LIST = 319
+ID_MBS_SETUPMOD_RES_LIST = 313
+
+failures = []
+checks = 0
+
+
+def check(cond, what):
+    global checks
+    checks += 1
+    if cond:
+        print("ok:   %s" % what)
+    else:
+        print("FAIL: %s" % what)
+        failures.append(what)
+
+
+def _pdu():
+    from pycrate_asn1dir import NGAP
+    return NGAP.NGAP_PDU_Descriptions.NGAP_PDU
+
+
+def _enc(val):
+    spec = _pdu()
+    spec.set_val(val)
+    return spec.to_aper()
+
+
+def _transfer(type_name, val):
+    from pycrate_asn1dir import NGAP
+    spec = getattr(NGAP.NGAP_IEs, type_name)
+    spec.set_val(val)
+    return spec.to_aper()
+
+
+def modify_request(ran_ue, tmgi=None):
+    """A PDU Session Resource Modify Request, with the MBS list when a TMGI is given."""
+    ies = []
+    if tmgi is not None:
+        ies.append({"id": ID_MBS_SETUPMOD_REQ_LIST, "criticality": "ignore",
+                    "value": ("MBSSessionSetuporModifyRequestList",
+                              [{"mBS-SessionID": {"tMGI": tmgi}}])})
+    transfer = _transfer("PDUSessionResourceModifyRequestTransfer", {"protocolIEs": ies})
+    return _enc(("initiatingMessage", {
+        "procedureCode": 26, "criticality": "reject",
+        "value": ("PDUSessionResourceModifyRequest", {"protocolIEs": [
+            {"id": ID_AMF_UE_NGAP_ID, "criticality": "reject", "value": ("AMF-UE-NGAP-ID", ran_ue)},
+            {"id": ID_RAN_UE_NGAP_ID, "criticality": "reject", "value": ("RAN-UE-NGAP-ID", ran_ue)},
+            {"id": ID_MODIFY_LIST_REQ, "criticality": "reject",
+             "value": ("PDUSessionResourceModifyListModReq", [
+                 {"pDUSessionID": 1, "pDUSessionResourceModifyRequestTransfer": transfer}])},
+        ]})}))
+
+
+def modify_response(ran_ue, tmgi):
+    """The gNB's successful outcome, with the MBS session list as an IE extension."""
+    transfer = _transfer("PDUSessionResourceModifyResponseTransfer", {"iE-Extensions": [
+        {"id": ID_MBS_SETUPMOD_RES_LIST, "criticality": "ignore",
+         "extensionValue": ("MBSSessionSetupResponseList", [{"mBS-SessionID": {"tMGI": tmgi}}])},
+    ]})
+    return _enc(("successfulOutcome", {
+        "procedureCode": 26, "criticality": "reject",
+        "value": ("PDUSessionResourceModifyResponse", {"protocolIEs": [
+            {"id": ID_AMF_UE_NGAP_ID, "criticality": "ignore", "value": ("AMF-UE-NGAP-ID", ran_ue)},
+            {"id": ID_RAN_UE_NGAP_ID, "criticality": "ignore", "value": ("RAN-UE-NGAP-ID", ran_ue)},
+            {"id": ID_MODIFY_LIST_RES, "criticality": "ignore",
+             "value": ("PDUSessionResourceModifyListModRes", [
+                 {"pDUSessionID": 1, "pDUSessionResourceModifyResponseTransfer": transfer}])},
+        ]})}))
+
+
+def activation(kind, tmgi):
+    name = ("MulticastSessionActivationRequest" if kind == "initiatingMessage"
+            else "MulticastSessionActivationResponse")
+    return _enc((kind, {
+        "procedureCode": 71, "criticality": "reject",
+        "value": (name, {"protocolIEs": [
+            {"id": ID_MBS_SESSION_ID, "criticality": "reject",
+             "value": ("MBS-SessionID", {"tMGI": tmgi})},
+        ]})}))
+
+
+def write_capture(path):
+    from scapy.all import Ether, IP, wrpcap
+    from scapy.layers.sctp import SCTP, SCTPChunkData
+
+    core, gnb = "192.168.77.10", "192.168.77.101"
+    pkts = []
+
+    def add(src, dst, payload):
+        pkts.append(Ether() / IP(src=src, dst=dst) / SCTP(sport=38412, dport=60000)
+                    / SCTPChunkData(proto_id=60, data=payload))
+
+    add(core, gnb, activation("initiatingMessage", TMGI))
+    add(gnb, core, activation("successfulOutcome", TMGI))
+    for ran_ue in (1, 2):
+        add(core, gnb, modify_request(ran_ue, TMGI))
+        add(gnb, core, modify_response(ran_ue, TMGI))
+    # a UE with an ordinary modification and no MBS at all: it must not appear
+    # anywhere the TMGI does.
+    add(core, gnb, modify_request(3))
+    # and another session's TMGI, so "find any TMGI" cannot pass for "find this one"
+    add(core, gnb, activation("initiatingMessage", OTHER_TMGI))
+
+    wrpcap(path, pkts)
+
+
+def run(path, *args):
+    out = subprocess.run([sys.executable, DECODER, path] + list(args),
+                         capture_output=True, text=True)
+    return out.stdout.splitlines()
+
+
+def main():
+    tmgi = TMGI.hex()
+    with tempfile.TemporaryDirectory() as d:
+        path = os.path.join(d, "n2.pcap")
+        write_capture(path)
+
+        act = run(path, "--procedure-code", "71")
+        check(any("initiatingMessage" in l and "tmgi=" + tmgi in l for l in act),
+              "the activation request is found, with its TMGI")
+        check(any("successfulOutcome" in l and "tmgi=" + tmgi in l for l in act),
+              "the gNB's activation response is found")
+        check(any("tmgi=" + OTHER_TMGI.hex() in l for l in act),
+              "another session's activation is reported with its own TMGI")
+
+        mod = run(path, "--procedure-code", "26")
+        joined = sorted({l.split("ran_ue=")[1].split()[0]
+                         for l in mod if "initiatingMessage" in l and "tmgi=" + tmgi in l})
+        answered = sorted({l.split("ran_ue=")[1].split()[0]
+                           for l in mod if "successfulOutcome" in l and "tmgi=" + tmgi in l})
+        check(joined == ["1", "2"],
+              "the TMGI inside the nested request transfer is found, for UEs 1 and 2 (got %s)" % joined)
+        check(answered == ["1", "2"],
+              "the TMGI inside the nested response transfer is found too (got %s)" % answered)
+        check(not any("ran_ue=3" in l and "tmgi=" in l for l in mod),
+              "the UE that did not join carries no TMGI")
+        check(any("ran_ue=3" in l for l in mod),
+              "that UE is still reported, so its absence above is a real negative")
+
+        only_two = run(path, "--procedure-code", "26", "--ran-ue", "2")
+        check(only_two and all("ran_ue=2" in l for l in only_two),
+              "--ran-ue narrows the report to one UE")
+
+        summary = run(path, "--summary")
+        check(len(summary) == len(set(summary)), "--summary reports each row once")
+
+    print("\n%d check(s), %d failed" % (checks, len(failures)))
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

