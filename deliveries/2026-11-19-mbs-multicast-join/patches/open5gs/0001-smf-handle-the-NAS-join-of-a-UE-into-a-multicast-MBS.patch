diff --git a/src/smf/context.c b/src/smf/context.c
index 439aad66..0dd0850a 100644
--- a/src/smf/context.c
+++ b/src/smf/context.c
@@ -2056,6 +2056,11 @@ void smf_sess_remove(smf_sess_t *sess)
 
     ogs_list_remove(&smf_ue->sess_list, sess);
 
+    /* A released PDU session leaves every multicast MBS session it had joined (TS 23.247 V18.8.0
+     * cl. 7.2.2.3: the UE is removed from the multicast MBS session when its associated PDU session
+     * is released). Nothing else in the release path knows about MBS, so it is done here. */
+    smf_mbs_member_remove_by_sess(sess);
+
     memset(&e, 0, sizeof(e));
     e.sess_id = sess->id;
     ogs_fsm_fini(&sess->sm, &e);
@@ -4094,6 +4099,101 @@ void smf_mbs_sess_context_released(smf_mbs_sess_t *mbs_sess, smf_mbs_amf_t *amf)
 
 /* The MBS session of a TMGI that a notification names: for a location dependent MBS session the part with
  * the Area Session ID of the notification, otherwise the session of the TMGI. */
+/*
+ * Membership of a multicast MBS session (TS 23.247 V18.8.0 cl. 7.2.1.3).
+ *
+ * A member is one associated PDU session, held by pool id. Holding the id rather than the pointer is
+ * what makes smf_mbs_member_find() able to notice that the PDU session has been released in the
+ * meantime -- the MBS session outlives its members, and nothing in the release path of a PDU session
+ * knows about MBS.
+ */
+smf_mbs_member_t *smf_mbs_member_find(smf_mbs_sess_t *mbs_sess, const smf_sess_t *sess)
+{
+    smf_mbs_member_t *member = NULL, *next = NULL;
+
+    ogs_assert(mbs_sess);
+    ogs_assert(sess);
+
+    ogs_list_for_each_safe(&mbs_sess->member_list, next, member) {
+        smf_sess_t *member_sess = smf_sess_find_by_id(member->sess_id);
+
+        if (!member_sess) {
+            /* the PDU session went away without telling us: take the stale entry out */
+            ogs_list_remove(&mbs_sess->member_list, member);
+            ogs_free(member);
+            continue;
+        }
+        if (member_sess == sess)
+            return member;
+    }
+
+    return NULL;
+}
+
+smf_mbs_member_t *smf_mbs_member_add(smf_mbs_sess_t *mbs_sess, const smf_sess_t *sess)
+{
+    smf_mbs_member_t *member = NULL;
+
+    ogs_assert(mbs_sess);
+    ogs_assert(sess);
+
+    /* A repeated join for the same session is not an error: TS 24.501 V18.14.0 cl. 6.3.2.2 has the SMF
+     * answer with "MBS join is accepted" either way, so the caller wants the existing entry back. */
+    member = smf_mbs_member_find(mbs_sess, sess);
+    if (member)
+        return member;
+
+    member = ogs_calloc(1, sizeof(*member));
+    ogs_assert(member);
+
+    member->sess_id = sess->id;
+    member->psi = sess->psi;
+
+    ogs_list_add(&mbs_sess->member_list, member);
+
+    return member;
+}
+
+void smf_mbs_member_remove(smf_mbs_sess_t *mbs_sess, smf_mbs_member_t *member)
+{
+    ogs_assert(mbs_sess);
+    ogs_assert(member);
+
+    ogs_list_remove(&mbs_sess->member_list, member);
+    ogs_free(member);
+}
+
+void smf_mbs_member_remove_all(smf_mbs_sess_t *mbs_sess)
+{
+    smf_mbs_member_t *member = NULL, *next = NULL;
+
+    ogs_assert(mbs_sess);
+
+    ogs_list_for_each_safe(&mbs_sess->member_list, next, member)
+        smf_mbs_member_remove(mbs_sess, member);
+}
+
+void smf_mbs_member_remove_by_sess(const smf_sess_t *sess)
+{
+    smf_mbs_sess_t *mbs_sess = NULL;
+
+    ogs_assert(sess);
+
+    /* Walked rather than indexed: a deployment has far fewer MBS sessions than PDU sessions, and an
+     * index the other way would have to be kept correct through every PDU session teardown path. */
+    ogs_list_for_each(&self.smf_mbs_sess_list, mbs_sess) {
+        smf_mbs_member_t *member = NULL, *next = NULL;
+
+        ogs_list_for_each_safe(&mbs_sess->member_list, next, member) {
+            if (member->sess_id != sess->id)
+                continue;
+            ogs_info("MBS session [%s]: PDU session %d left (released)",
+                    mbs_sess->mbs_session_ref ? mbs_sess->mbs_session_ref : "?", member->psi);
+            smf_mbs_member_remove(mbs_sess, member);
+        }
+    }
+}
+
 smf_mbs_sess_t *smf_mbs_sess_find_by_tmgi_and_area(
         ogs_tmgi_t *tmgi_to_find, bool has_area_session_id, uint16_t area_session_id)
 {
@@ -4180,6 +4280,9 @@ static void smf_mbs_sess_free(smf_mbs_sess_t *smf_mbs_sess)
             smf_mbs_sess_dl_tunnel_remove(smf_mbs_sess, tunnel);
     }
 
+    /* the membership ends with the session */
+    smf_mbs_member_remove_all(smf_mbs_sess);
+
     if (smf_mbs_sess->service_type)
         ogs_free(smf_mbs_sess->service_type);
 
