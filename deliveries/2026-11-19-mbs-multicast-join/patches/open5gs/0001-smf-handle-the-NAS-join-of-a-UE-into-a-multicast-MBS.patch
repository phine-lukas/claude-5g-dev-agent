+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#include "mbs-join.h"
+#include "gsm-build.h"
+#include "ngap-build.h"
+#include "sbi-path.h"
+
+#undef OGS_LOG_DOMAIN
+#define OGS_LOG_DOMAIN __smf_log_domain
+
+/*
+ * The contents of a Requested MBS container, TS 24.501 V18.14.0 clause 9.11.4.30 figure 9.11.4.30.2:
+ *
+ *   octet 4   bits 1-2  Type of multicast MBS session ID
+ *             bits 3-4  MBS operation
+ *             bits 5-8  spare
+ *   octet 5.. the multicast MBS session ID itself: 6 octets for a TMGI (figure 9.11.4.30.3), or a
+ *             source/destination address pair for the SSM forms (figure 9.11.4.30.4), 8 octets for
+ *             IPv4 and 32 for IPv6.
+ *
+ * The entries are not length-prefixed, so the length of each one follows from its ID type -- which
+ * is also why an unknown ID type has to end the parse rather than be skipped.
+ */
+#define SMF_MBS_ID_TYPE(octet)  ((octet) & 0x03)
+#define SMF_MBS_OPERATION(octet) (((octet) >> 2) & 0x03)
+
+bool smf_mbs_tmgi_to_octets(const ogs_tmgi_t *tmgi, uint8_t *out)
+{
+    ogs_assert(tmgi);
+    ogs_assert(out);
+
+    if (!tmgi->mbs_service_id) {
+        ogs_error("TMGI without an MBS Service ID");
+        return false;
+    }
+    if (strlen(tmgi->mbs_service_id) != 6) {
+        ogs_error("MBS Service ID [%s] is not 6 hex characters", tmgi->mbs_service_id);
+        return false;
+    }
+
+    /* The same layout ogs_ngap_5gs_tmgi_to_ASN() produces: 3 octets of service id then the PLMN
+     * identity copied whole, which is already in its TS 24.008 wire encoding. */
+    ogs_ascii_to_hex(tmgi->mbs_service_id, 6, out, 3);
+    memcpy(out + 3, &tmgi->plmn_id, OGS_PLMN_ID_LEN);
+
+    return true;
+}
+
+int smf_mbs_parse_requested_container(
+        const uint8_t *buf, uint16_t len, smf_mbs_request_t *out, int max)
+{
+    uint16_t pos = 0;
+    int num = 0;
+
+    ogs_assert(out);
+
+    if (!buf) {
+        ogs_error("Requested MBS container without contents");
+        return -1;
+    }
+
+    while (pos < len) {
+        uint8_t octet4 = buf[pos];
+        uint8_t id_type = SMF_MBS_ID_TYPE(octet4);
+        uint8_t operation = SMF_MBS_OPERATION(octet4);
+        uint16_t id_len;
+
+        switch (id_type) {
+        case SMF_MBS_SESSION_ID_TMGI:
+            id_len = SMF_MBS_TMGI_LEN;
+            break;
+        case SMF_MBS_SESSION_ID_SSM_IPV4:
+            id_len = 8;     /* two IPv4 addresses */
+            break;
+        case SMF_MBS_SESSION_ID_SSM_IPV6:
+            id_len = 32;    /* two IPv6 addresses */
+            break;
+        default:
+            /* "All other values are reserved": with no length to skip, the rest of the container
+             * cannot be located, so the whole IE is rejected. */
+            ogs_error("Requested MBS container: reserved session ID type [%d] at octet %d",
+                    id_type, pos);
+            return -1;
+        }
+
+        if ((uint32_t)pos + 1 + id_len > len) {
+            ogs_error("Requested MBS container: entry at octet %d runs past the IE (%d octets)",
+                    pos, len);
+            return -1;
+        }
+
+        if (operation != SMF_MBS_OP_JOIN && operation != SMF_MBS_OP_LEAVE) {
+            ogs_error("Requested MBS container: reserved MBS operation [%d]", operation);
+            return -1;
+        }
+
+        if (num < max) {
+            memset(&out[num], 0, sizeof(out[num]));
+            out[num].operation = (smf_mbs_operation_e)operation;
+            out[num].session_id_type = (smf_mbs_session_id_type_e)id_type;
+            if (id_type == SMF_MBS_SESSION_ID_TMGI)
+                memcpy(out[num].tmgi, buf + pos + 1, SMF_MBS_TMGI_LEN);
+            num++;
+        } else {
+            ogs_warn("Requested MBS container: more than %d entries, the rest is ignored", max);
+        }
+
+        pos += 1 + id_len;
+    }
+
+    return num;
+}
+
+/*
+ * The contents of a Received MBS container, TS 24.501 V18.14.0 clause 9.11.4.31 figure 9.11.4.31.2:
+ *
+ *   octet 4   bits 1-3  MBS decision (MD)
+ *             bits 4-5  MBS service area indication (MSAI)
+ *             bits 6-8  Rejection cause
+ *   octet 5   bit  1    IP address existence (IPAE)
+ *             bits 2-3  MBS timer indication (MTI)
+ *             bit  4    MBS security container indication (MSCI)
+ *             bit  5    IP address type (IPAT)
+ *             bits 6-8  spare
+ *   octet 6.. TMGI (6 octets)
+ *
+ * Everything the flags can switch on is left out, so one entry is always 8 octets. The TMGI is always
+ * present: cl. 6.3.2.2 has the SMF "include the TMGI for the multicast MBS session IDs that the UE is
+ * allowed to join" and the mirror of that for the rejected ones, whatever the UE used to ask.
+ */
+#define SMF_MBS_RECEIVED_ENTRY_LEN 8
+
+int smf_mbs_build_received_container(
+        uint8_t *buf, uint16_t size, const smf_mbs_result_t *results, int num)
+{
+    int i;
+    uint16_t pos = 0;
+
+    ogs_assert(buf);
+    ogs_assert(results);
+
+    if ((uint32_t)num * SMF_MBS_RECEIVED_ENTRY_LEN > size) {
+        ogs_error("Received MBS container: %d entries do not fit in %d octets", num, size);
+        return -1;
+    }
+
+    for (i = 0; i < num; i++) {
+        uint8_t cause = 0;
+
+        /* "If MD is set to 'MBS join is rejected' or 'Remove UE from multicast MBS session', bits 6
+         * to 8 of octet 4 shall contain the Rejection cause [...] otherwise bits 6 to 8 of octet 4
+         * are spare and shall be coded as zero." */
+        if (results[i].decision == SMF_MBS_DECISION_JOIN_REJECTED ||
+                results[i].decision == SMF_MBS_DECISION_REMOVE_UE)
+            cause = (uint8_t)results[i].reject_cause & 0x07;
+
+        buf[pos++] = (uint8_t)((cause << 5) | ((uint8_t)results[i].decision & 0x07));
+        buf[pos++] = 0; /* IPAE=0, MTI=00, MSCI=0, IPAT=0, spare */
+        memcpy(buf + pos, results[i].tmgi, SMF_MBS_TMGI_LEN);
+        pos += SMF_MBS_TMGI_LEN;
+    }
+
+    return pos;
+}
+
+/* PDU SESSION MODIFICATION COMMAND carrying nothing but a Received MBS container.
+ *
+ * A join changes no QoS rule and no QoS flow description -- the multicast QoS flows live in the MBS
+ * session, not in the PDU session -- so gsm_build_pdu_session_modification_command() cannot be
+ * reused: it builds its lists out of sess->qos_flow_to_modify_list, which is empty here. */
+static ogs_pkbuf_t *build_modification_command(
+        smf_sess_t *sess, const smf_mbs_result_t *results, int num)
+{
+    ogs_nas_5gs_message_t message;
+    ogs_nas_5gs_pdu_session_modification_command_t *command =
+            &message.gsm.pdu_session_modification_command;
+    uint8_t contents[SMF_MBS_MAX_REQUESTS * SMF_MBS_RECEIVED_ENTRY_LEN];
+    int len;
+
+    ogs_assert(sess);
+
+    len = smf_mbs_build_received_container(contents, sizeof(contents), results, num);
+    if (len < 0)
+        return NULL;
+
+    memset(&message, 0, sizeof(message));
+    message.gsm.h.extended_protocol_discriminator =
+            OGS_NAS_EXTENDED_PROTOCOL_DISCRIMINATOR_5GSM;
+    message.gsm.h.pdu_session_identity = sess->psi;
+    message.gsm.h.procedure_transaction_identity = sess->pti;
+    message.gsm.h.message_type = OGS_NAS_5GS_PDU_SESSION_MODIFICATION_COMMAND;
+
+    command->presencemask |=
+        OGS_NAS_5GS_PDU_SESSION_MODIFICATION_COMMAND_RECEIVED_MBS_CONTAINER_PRESENT;
+    command->received_mbs_container.length = len;
+    command->received_mbs_container.buffer = contents;
+
+    return ogs_nas_5gs_plain_encode(&message);
+}
+
+/* Ask the RAN to activate the session, through the AMF (TS 29.518 V17.8.0 cl. 5.7.2.2,
+ * Namf_MBSCommunication N2MessageTransfer with ngapIeType MBS_SES_ACT_REQ). The AMF already knows
+ * how to wrap it into a MULTICAST SESSION ACTIVATION REQUEST; only the transfer is built here. */
+static void activate_in_ran(smf_mbs_sess_t *mbs_sess)
+{
+    ogs_assert(mbs_sess);
+
+    if (mbs_sess->ran_activated)
+        return;
+    if (!mbs_sess->tmgi) {
+        ogs_error("MBS session without a TMGI cannot be activated in the RAN");
+        return;
+    }
+
+    if (smf_sbi_send_mbs_comm_n2_message_transfer(
+                mbs_sess, OpenAPI_mbs_ngap_ie_type_MBS_SES_ACT_REQ) != OGS_OK) {
+        ogs_error("Failed to send the Multicast Session Activation to the AMF");
+        return;
+    }
+
+    mbs_sess->ran_activated = true;
+    mbs_sess->state = smf_mbs_sess_multicast_state_active;
+    mbs_sess->activity_status = OpenAPI_mbs_session_activity_status_ACTIVE;
+}
+
+/*
+ * The join itself. TS 23.247 V18.8.0 cl. 7.2.1.3:
+ *
+ *   step 2  find the MBS session context for the TMGI. In this deployment the SMF and the MB-SMF are
+ *           one process (one open5gs-smfd serves both roles), so the NRF discovery and the
+ *           Nmbsmf_MBSSession_ContextStatusSubscribe of steps 2 and 3 are a lookup in this process's
+ *           own context. A split deployment replaces find_multicast_session() with those two calls.
+ *   step 4  authorise. There is no MBS subscription data in this deployment, so a session the MB-SMF
+ *           knows is accepted and one it does not know is rejected with "Session context not found".
+ *   step 5  answer the UpdateSMContext with the N1 container (Modification Command, Received MBS
+ *           container) and the N2 SM information (PDU Session Resource Modify Request Transfer with
+ *           the MBS session to set up).
+ */
+static smf_mbs_sess_t *find_multicast_session(const uint8_t *tmgi_octets)
+{
+    smf_mbs_sess_t *mbs_sess = NULL;
+
+    ogs_list_for_each(&smf_self()->smf_mbs_sess_list, mbs_sess) {
+        uint8_t octets[SMF_MBS_TMGI_LEN];
+
+        if (!mbs_sess->service_type ||
+                ogs_strcasecmp(mbs_sess->service_type, "MULTICAST") != 0)
+            continue;
+        if (!mbs_sess->tmgi)
+            continue;
+        if (!smf_mbs_tmgi_to_octets(mbs_sess->tmgi, octets))
+            continue;
+        if (memcmp(octets, tmgi_octets, SMF_MBS_TMGI_LEN) == 0)
+            return mbs_sess;
+    }
+
+    return NULL;
+}
+
+static void tmgi_hex(const uint8_t *tmgi, char *out, size_t size)
+{
+    int i;
+
+    for (i = 0; i < SMF_MBS_TMGI_LEN && (size_t)(2 * i + 3) <= size; i++)
+        ogs_snprintf(out + 2 * i, 3, "%02x", tmgi[i]);
+}
+
+bool smf_mbs_handle_join(smf_sess_t *sess, ogs_sbi_stream_t *stream,
+        const ogs_nas_requested_mbs_container_t *container)
+{
+    smf_mbs_request_t requests[SMF_MBS_MAX_REQUESTS];
+    smf_mbs_result_t results[SMF_MBS_MAX_REQUESTS];
+    smf_mbs_sess_t *accepted[SMF_MBS_MAX_REQUESTS];
+    uint8_t accepted_tmgi[SMF_MBS_MAX_REQUESTS][SMF_MBS_TMGI_LEN];
+    int num_requests, num_results = 0, num_accepted = 0, i;
+    ogs_pkbuf_t *n1smbuf = NULL, *n2smbuf = NULL;
+    smf_ue_t *smf_ue = NULL;
+
+    ogs_assert(sess);
+    ogs_assert(stream);
+    ogs_assert(container);
+
+    smf_ue = smf_ue_find_by_id(sess->smf_ue_id);
+    ogs_assert(smf_ue);
+
+    num_requests = smf_mbs_parse_requested_container(
+            container->buffer, container->length, requests, SMF_MBS_MAX_REQUESTS);
+    if (num_requests < 0) {
+        n1smbuf = gsm_build_pdu_session_modification_reject(
+                sess, OGS_5GSM_CAUSE_SEMANTICALLY_INCORRECT_MESSAGE);
+        ogs_assert(n1smbuf);
+        smf_sbi_send_sm_context_update_error_n1_n2_message(
+                stream, OGS_SBI_HTTP_STATUS_BAD_REQUEST,
+                n1smbuf, OpenAPI_n2_sm_info_type_NULL, NULL);
+        return true;
+    }
+
+    for (i = 0; i < num_requests; i++) {
+        smf_mbs_sess_t *mbs_sess = NULL;
+        char hex[2 * SMF_MBS_TMGI_LEN + 1] = {0};
+
+        if (requests[i].session_id_type != SMF_MBS_SESSION_ID_TMGI) {
+            /* Joining by source specific IP multicast address is in the IE but not here: the MB-SMF
+             * indexes a multicast session by TMGI, and the SSM form would need the SSM index plus a
+             * decision about which TMGI to answer with. */
+            ogs_warn("MBS join by source specific IP multicast address is not supported");
+            continue;
+        }
+
+        tmgi_hex(requests[i].tmgi, hex, sizeof(hex));
+
+        if (requests[i].operation == SMF_MBS_OP_LEAVE) {
+            /* Leaving is MBS-MC-03/MBS-MC-04 and is not built yet. Answering "Remove UE from
+             * multicast MBS session" would be a lie, so the entry is left out of the answer. */
+            ogs_warn("[%s:%d] MBS leave of TMGI %s is not implemented, ignored",
+                    smf_ue->supi, sess->psi, hex);
+            continue;
+        }
+
+        memset(&results[num_results], 0, sizeof(results[num_results]));
+        memcpy(results[num_results].tmgi, requests[i].tmgi, SMF_MBS_TMGI_LEN);
+
+        mbs_sess = find_multicast_session(requests[i].tmgi);
+        if (!mbs_sess) {
+            ogs_warn("[%s:%d] MBS join of TMGI %s: no multicast session with that TMGI",
+                    smf_ue->supi, sess->psi, hex);
+            results[num_results].decision = SMF_MBS_DECISION_JOIN_REJECTED;
+            results[num_results].reject_cause = SMF_MBS_REJECT_CONTEXT_NOT_FOUND;
+            num_results++;
+            continue;
+        }
+
+        /* TS 23.247 V18.8.0 cl. 7.2.1.3 step 4 wants the MBS subscription data of the UDM here. The
+         * subscriber provisioning of this deployment has none, so every UE that reaches this point
+         * is authorised. One place to change when it does. */
+
+        ogs_assert(smf_mbs_member_add(mbs_sess, sess));
+        ogs_info("[%s:%d] joined multicast MBS session TMGI %s (%d member(s))",
+                smf_ue->supi, sess->psi, hex, ogs_list_count(&mbs_sess->member_list));
+
+        results[num_results].decision = SMF_MBS_DECISION_JOIN_ACCEPTED;
+        num_results++;
+
+        accepted[num_accepted] = mbs_sess;
+        memcpy(accepted_tmgi[num_accepted], requests[i].tmgi, SMF_MBS_TMGI_LEN);
+        num_accepted++;
+    }
+
+    if (!num_results) {
+        /* Nothing in the container this build acts on: let the caller handle the modification as it
+         * otherwise would. */
+        return false;
+    }
+
+    n1smbuf = build_modification_command(sess, results, num_results);
+    if (!n1smbuf) {
+        ogs_error("[%s:%d] could not build the PDU Session Modification Command",
+                smf_ue->supi, sess->psi);
+        n1smbuf = gsm_build_pdu_session_modification_reject(
+                sess, OGS_5GSM_CAUSE_PROTOCOL_ERROR_UNSPECIFIED);
+        ogs_assert(n1smbuf);
+        smf_sbi_send_sm_context_update_error_n1_n2_message(
+                stream, OGS_SBI_HTTP_STATUS_INTERNAL_SERVER_ERROR,
+                n1smbuf, OpenAPI_n2_sm_info_type_NULL, NULL);
+        return true;
+    }
+
+    if (num_accepted) {
+        n2smbuf = ngap_build_pdu_session_resource_modify_request_transfer_mbs(
+                accepted_tmgi, num_accepted);
+        if (!n2smbuf) {
+            ogs_error("[%s:%d] could not build the N2 SM information of the join",
+                    smf_ue->supi, sess->psi);
+            ogs_pkbuf_free(n1smbuf);
+            n1smbuf = gsm_build_pdu_session_modification_reject(
+                    sess, OGS_5GSM_CAUSE_PROTOCOL_ERROR_UNSPECIFIED);
+            ogs_assert(n1smbuf);
+            smf_sbi_send_sm_context_update_error_n1_n2_message(
+                    stream, OGS_SBI_HTTP_STATUS_INTERNAL_SERVER_ERROR,
+                    n1smbuf, OpenAPI_n2_sm_info_type_NULL, NULL);
+            return true;
+        }
+        smf_sbi_send_sm_context_updated_data_n1_n2_message(
+                sess, stream, n1smbuf, OpenAPI_n2_sm_info_type_PDU_RES_MOD_REQ, n2smbuf);
+    } else {
+        /* Every entry was rejected: cl. 7.2.1.3 step 5, "the message will not contain any MBS Session
+         * Context or the N2 SM information for the associated PDU session". The Modification Command
+         * still goes out, because the UE has to learn why. */
+        smf_sbi_send_sm_context_updated_data_n1_n2_message(
+                sess, stream, n1smbuf, OpenAPI_n2_sm_info_type_NULL, NULL);
+    }
+
+    /* Step 7a/8: the session has to be active in the RAN for the radio resources to be configured.
+     * Done after the per-UE N2 so the gNB has the MBS session context before it is told to activate
+     * it, which is the order cl. 7.2.1.3 puts steps 6 and 7a in. */
+    for (i = 0; i < num_accepted; i++)
+        activate_in_ran(accepted[i]);
+
+    return true;
+}
diff --git a/src/smf/mbs-join.h b/src/smf/mbs-join.h
new file mode 100644
index 00000000..4ad98647
--- /dev/null
+++ b/src/smf/mbs-join.h
@@ -0,0 +1,114 @@
+/*
+ * MBS multicast join over NAS (TS 23.247 V18.8.0 clause 7.2.1.3).
+ *
+ * This file is part of Open5GS.
+ *
+ * This program is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+#ifndef SMF_MBS_JOIN_H
+#define SMF_MBS_JOIN_H
+
+#include "context.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A TMGI on the wire is 6 octets both in NAS (TS 24.501 V18.14.0 cl. 9.11.4.30: "coded as described in
+ * clause 10.5.6.13 in 3GPP TS 24.008 starting from octet 2" -- 3 octets of MBS Service ID then the
+ * PLMN) and in NGAP (TS 38.413 V17.10.0 cl. 9.3.1.153, TMGI ::= OCTET STRING (SIZE(6))). The two
+ * encodings are byte for byte the same, which is why one buffer serves both. */
+#define SMF_MBS_TMGI_LEN 6
+
+/* How many multicast MBS sessions one Requested MBS container may ask about. The IE itself allows up
+ * to 65535 octets of entries; this is what the SMF will act on in one request. */
+#define SMF_MBS_MAX_REQUESTS 8
+
+/* MBS operation, TS 24.501 V18.14.0 cl. 9.11.4.30 table 9.11.4.30.1 (bits 3 to 4 of octet 4) */
+typedef enum smf_mbs_operation_e {
+    SMF_MBS_OP_JOIN     = 1,
+    SMF_MBS_OP_LEAVE    = 2,
+} smf_mbs_operation_e;
+
+/* Type of multicast MBS session ID, same table (bits 1 to 2 of octet 4) */
+typedef enum smf_mbs_session_id_type_e {
+    SMF_MBS_SESSION_ID_TMGI     = 1,
+    SMF_MBS_SESSION_ID_SSM_IPV4 = 2,
+    SMF_MBS_SESSION_ID_SSM_IPV6 = 3,
+} smf_mbs_session_id_type_e;
+
+/* MBS decision, TS 24.501 V18.14.0 cl. 9.11.4.31 table 9.11.4.31.1 (bits 1 to 3 of octet 4) */
+typedef enum smf_mbs_decision_e {
+    SMF_MBS_DECISION_SERVICE_AREA_UPDATE = 1,
+    SMF_MBS_DECISION_JOIN_ACCEPTED       = 2,
+    SMF_MBS_DECISION_JOIN_REJECTED       = 3,
+    SMF_MBS_DECISION_REMOVE_UE           = 4,
+    SMF_MBS_DECISION_SECURITY_UPDATE     = 5,
+} smf_mbs_decision_e;
+
+/* Rejection cause, same table (bits 6 to 8 of octet 4) */
+typedef enum smf_mbs_reject_cause_e {
+    SMF_MBS_REJECT_NO_INFO              = 0,
+    SMF_MBS_REJECT_INSUFFICIENT_RES     = 1,
+    SMF_MBS_REJECT_NOT_AUTHORIZED       = 2,
+    SMF_MBS_REJECT_NOT_STARTED          = 3,
+    SMF_MBS_REJECT_OUTSIDE_SERVICE_AREA = 4,
+    SMF_MBS_REJECT_CONTEXT_NOT_FOUND    = 5,
+    SMF_MBS_REJECT_SESSION_RELEASED     = 6,
+} smf_mbs_reject_cause_e;
+
+/* One "multicast MBS session information" of a Requested MBS container */
+typedef struct smf_mbs_request_s {
+    smf_mbs_operation_e operation;
+    smf_mbs_session_id_type_e session_id_type;
+    uint8_t tmgi[SMF_MBS_TMGI_LEN];     /* set when session_id_type is TMGI */
+} smf_mbs_request_t;
+
+/* One "Received MBS information" of a Received MBS container */
+typedef struct smf_mbs_result_s {
+    smf_mbs_decision_e decision;
+    smf_mbs_reject_cause_e reject_cause; /* only read for JOIN_REJECTED and REMOVE_UE */
+    uint8_t tmgi[SMF_MBS_TMGI_LEN];
+} smf_mbs_result_t;
+
+/* The 6 wire octets of \p tmgi (see SMF_MBS_TMGI_LEN). Returns false when the TMGI has no service id
+ * or its service id is not 6 hex characters. */
+bool smf_mbs_tmgi_to_octets(const ogs_tmgi_t *tmgi, uint8_t *out);
+
+/** Parse the contents of a Requested MBS container (TS 24.501 V18.14.0 cl. 9.11.4.30).
+ *  \p buf / \p len are the container contents, i.e. what follows the IEI and the 2-octet length.
+ *  Returns the number of entries written to \p out, or -1 when the container is malformed. */
+int smf_mbs_parse_requested_container(
+        const uint8_t *buf, uint16_t len, smf_mbs_request_t *out, int max);
+
+/** Build the contents of a Received MBS container (TS 24.501 V18.14.0 cl. 9.11.4.31) into \p buf.
+ *  Only the mandatory part of each entry is produced: no IP addresses (IPAE=0), no MBS service area
+ *  (MSAI=00), no timers (MTI=00) and no security container (MSCI=0).
+ *  Returns the number of octets written, or -1 when \p size is too small. */
+int smf_mbs_build_received_container(
+        uint8_t *buf, uint16_t size, const smf_mbs_result_t *results, int num);
+
+/** Handle a PDU Session Modification Request that carries a Requested MBS container.
+ *  Answers \p stream itself (with a Modification Command, or a Modification Reject on a protocol
+ *  error) and returns true when it did. Returns false when the container asks for nothing this
+ *  build handles, in which case the caller carries on with the ordinary modification handling. */
+bool smf_mbs_handle_join(smf_sess_t *sess, ogs_sbi_stream_t *stream,
+        const ogs_nas_requested_mbs_container_t *container);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SMF_MBS_JOIN_H */
