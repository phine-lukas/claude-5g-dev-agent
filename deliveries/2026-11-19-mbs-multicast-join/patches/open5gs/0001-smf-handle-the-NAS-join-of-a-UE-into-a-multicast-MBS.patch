diff --git a/src/smf/namf-build.c b/src/smf/namf-build.c
index b23a3a80..ffef436a 100644
--- a/src/smf/namf-build.c
+++ b/src/smf/namf-build.c
@@ -416,6 +416,91 @@ cleanup:
     return request;
 }
 
+/*
+ * Namf_MBSCommunication N2MessageTransfer (TS 29.518 V17.8.0 cl. 5.7.2.2): "used by the NF Service
+ * Consumer (e.g. MB-SMF) to request the AMF to transfer an MBS related N2 message to the NG-RAN nodes
+ * serving the multicast MBS session."
+ *
+ * The request carries the MBS Session ID in JSON and the already ASN.1-encoded NGAP transfer as a
+ * separate part of the multipart body, referenced by content id -- the same arrangement
+ * smf_namf_build_mbs_broadcast_context_create_request() above uses for its own N2 information. Which
+ * top-level NGAP procedure the AMF builds from it is chosen by ngapIeType, carried in \p data.
+ */
+ogs_sbi_request_t *smf_namf_build_mbs_comm_n2_message_transfer_request(
+        smf_mbs_sess_t *mbs_sess, void *data)
+{
+    ogs_sbi_message_t message;
+    ogs_sbi_request_t *request = NULL;
+
+    OpenAPI_mbs_n2_message_transfer_req_data_t *MbsN2MessageTransferReqData = NULL;
+    OpenAPI_mbs_comm_n2_mbs_sm_info_t *n2_mbs_sm_info = NULL;
+    OpenAPI_ref_to_binary_data_t *ngap_data = NULL;
+    OpenAPI_mbs_session_id_t *mbs_session_id = NULL;
+    OpenAPI_plmn_id_t *plmn_id = NULL;
+    OpenAPI_tmgi_t *tmgi = NULL;
+    char *mcc = NULL, *mnc = NULL;
+    OpenAPI_mbs_ngap_ie_type_e ngap_ie_type;
+    ogs_pkbuf_t *n2buf = NULL;
+
+    ogs_assert(mbs_sess);
+    ogs_assert(data);
+    ogs_assert(mbs_sess->tmgi);
+
+    ngap_ie_type = *(OpenAPI_mbs_ngap_ie_type_e *)data;
+
+    switch (ngap_ie_type) {
+    case OpenAPI_mbs_ngap_ie_type_MBS_SES_ACT_REQ:
+        n2buf = ngap_build_multicast_session_activation_request_transfer(mbs_sess->tmgi);
+        break;
+    default:
+        ogs_error("Namf_MBSCommunication N2MessageTransfer: ngapIeType [%d] is not built here",
+                ngap_ie_type);
+        return NULL;
+    }
+    if (!n2buf) {
+        ogs_error("Failed to build the N2 MBS SM information");
+        return NULL;
+    }
+
+    memset(&message, 0, sizeof(message));
+    message.h.method = (char *) OGS_SBI_HTTP_METHOD_POST;
+    message.h.service.name = (char *) OGS_SBI_SERVICE_NAME_NAMF_MBS_COMM;
+    message.h.api.version = (char *) OGS_SBI_API_V1;
+    message.h.resource.component[0] = (char *) OGS_SBI_RESOURCE_NAME_N2_MESSAGES;
+
+    mcc = ogs_plmn_id_mcc_string(&mbs_sess->tmgi->plmn_id);
+    mnc = ogs_plmn_id_mnc_string(&mbs_sess->tmgi->plmn_id);
+    plmn_id = OpenAPI_plmn_id_create(mcc, mnc);
+    tmgi = OpenAPI_tmgi_create(ogs_strdup(mbs_sess->tmgi->mbs_service_id), plmn_id);
+    mbs_session_id = OpenAPI_mbs_session_id_create(tmgi, NULL,
+            mbs_sess->mbs_session_id.nid ? ogs_strdup(mbs_sess->mbs_session_id.nid) : NULL);
+
+    ngap_data = OpenAPI_ref_to_binary_data_create(ogs_strdup((char *) OGS_SBI_CONTENT_NGAP_SM_ID));
+    n2_mbs_sm_info = OpenAPI_mbs_comm_n2_mbs_sm_info_create(ngap_ie_type, ngap_data);
+
+    /* areaSessionId is only for a location dependent MBS session (TS 29.532 V18.6.0 cl. 5.3.2.2.1);
+     * this one is not, so it is left out. */
+    MbsN2MessageTransferReqData = OpenAPI_mbs_n2_message_transfer_req_data_create(
+            mbs_session_id, false, 0, n2_mbs_sm_info, NULL);
+
+    message.MbsN2MessageTransferReqData = MbsN2MessageTransferReqData;
+
+    message.part[message.num_of_part].pkbuf = n2buf;
+    message.part[message.num_of_part].content_id = (char *) OGS_SBI_CONTENT_NGAP_SM_ID;
+    message.part[message.num_of_part].content_type = (char *) OGS_SBI_CONTENT_NGAP_TYPE;
+    message.num_of_part++;
+
+    message.http.accept = (char *) (OGS_SBI_CONTENT_JSON_TYPE "," OGS_SBI_CONTENT_PROBLEM_TYPE);
+
+    request = ogs_sbi_build_request(&message);
+    ogs_expect(request);
+
+    OpenAPI_mbs_n2_message_transfer_req_data_free(MbsN2MessageTransferReqData);
+    ogs_pkbuf_free(n2buf);
+
+    return request;
+}
+
 /*
  * 3GPP TS 29.518 - Release 17.11.0
  * 5G System; Access and Mobility Management Services; Stage 3
diff --git a/src/smf/namf-build.h b/src/smf/namf-build.h
