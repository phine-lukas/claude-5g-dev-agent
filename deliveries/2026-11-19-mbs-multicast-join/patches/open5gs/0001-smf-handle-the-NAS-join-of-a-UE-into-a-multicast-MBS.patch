+     * returns, the same way the broadcast ContextUpdate passes its stack smf_namf_context_update_param_t. */
+    return smf_sbi_old_discover_and_send(
+            OGS_SBI_SERVICE_TYPE_NAMF_MBS_COMM, NULL,
+            smf_namf_build_mbs_comm_n2_message_transfer_request,
+            mbs_sess, NULL, 0, &ngap_ie_type);
+}
