diff --git a/src/smf/ngap-build.c b/src/smf/ngap-build.c
index b8c7c615..e69bde99 100644
--- a/src/smf/ngap-build.c
+++ b/src/smf/ngap-build.c
@@ -377,6 +377,90 @@ ogs_pkbuf_t *ngap_build_pdu_session_resource_modify_request_transfer(
             &asn_DEF_NGAP_PDUSessionResourceModifyRequestTransfer, &message);
 }
 
+/* PDU Session Resource Modify Request Transfer carrying only the MBS sessions a UE joined
+ * (TS 38.413 V17.10.0 cl. 9.3.4.3 and the IE list PDUSessionResourceModifyRequestTransferIEs:
+ * id-MBSSessionSetuporModifyRequestList, ProtocolIE-ID 319, criticality ignore).
+ *
+ * TS 23.247 V18.8.0 cl. 7.2.1.3 step 5 calls this "the relation between the Multicast MBS Session
+ * Context and the UE's PDU Session context". Each item is an MBS Session ID and nothing else:
+ *
+ *   MBSSessionSetuporModifyRequestItem ::= SEQUENCE {
+ *       mBS-SessionID                                 MBS-SessionID,
+ *       mBS-AreaSessionID                             MBS-AreaSessionID   OPTIONAL,
+ *       associatedMBSQosFlowSetuporModifyRequestList  ...                 OPTIONAL,
+ *       mBS-QosFlowToReleaseList                      ...                 OPTIONAL, ... }
+ *
+ * The associated QoS flow list is for 5GC Individual MBS traffic delivery -- the fall-back for an
+ * NG-RAN that does not support MBS, where the multicast flows are carried in the PDU session's own
+ * unicast flows (cl. 7.2.1.3 step 5, "mapping information between unicast QoS flow(s) and multicast
+ * QoS flow(s)"). The RAN here supports MBS, cl. 7.2.1.3 step 6 says that with shared delivery "the
+ * associated unicast QoS flow information, if provided, is not used", and there are no multicast QoS
+ * flows to map yet, so it is left out.
+ *
+ * \p tmgi is \p num TMGIs in their 6-octet wire form (see smf_mbs_tmgi_to_octets()). */
+ogs_pkbuf_t *ngap_build_pdu_session_resource_modify_request_transfer_mbs(
+        const uint8_t tmgi[][6], int num)
+{
+    NGAP_PDUSessionResourceModifyRequestTransfer_t message;
+    NGAP_PDUSessionResourceModifyRequestTransferIEs_t *ie = NULL;
+    NGAP_MBSSessionSetuporModifyRequestList_t *MBSSessionSetuporModifyRequestList = NULL;
+    int i;
+
+    ogs_assert(tmgi);
+    ogs_assert(num > 0);
+
+    ogs_debug("PDUSessionResourceModifyRequestTransfer (MBS, %d session(s))", num);
+    memset(&message, 0, sizeof(message));
+
+    ie = CALLOC(1, sizeof(NGAP_PDUSessionResourceModifyRequestTransferIEs_t));
+    ogs_assert(ie);
+    ASN_SEQUENCE_ADD(&message.protocolIEs, ie);
+
+    ie->id = NGAP_ProtocolIE_ID_id_MBSSessionSetuporModifyRequestList;
+    ie->criticality = NGAP_Criticality_ignore;
+    ie->value.present =
+        NGAP_PDUSessionResourceModifyRequestTransferIEs__value_PR_MBSSessionSetuporModifyRequestList;
+
+    MBSSessionSetuporModifyRequestList =
+        &ie->value.choice.MBSSessionSetuporModifyRequestList;
+
+    for (i = 0; i < num; i++) {
+        NGAP_MBSSessionSetuporModifyRequestItem_t *item =
+            CALLOC(1, sizeof(NGAP_MBSSessionSetuporModifyRequestItem_t));
+        ogs_assert(item);
+        ASN_SEQUENCE_ADD(&MBSSessionSetuporModifyRequestList->list, item);
+
+        ogs_asn_buffer_to_OCTET_STRING(
+                (void *)tmgi[i], 6, &item->mBS_SessionID.tMGI);
+    }
+
+    return ogs_asn_encode(
+            &asn_DEF_NGAP_PDUSessionResourceModifyRequestTransfer, &message);
+}
+
+/* Multicast Session Activation Request Transfer (TS 38.413 V17.10.0):
+ *
+ *   MulticastSessionActivationRequestTransfer ::= SEQUENCE {
+ *       mBS-SessionID   MBS-SessionID, iE-Extensions ... OPTIONAL, ... }
+ *
+ * i.e. the TMGI again and nothing else. The AMF's own builder
+ * (ngap_build_multicast_session_activation_request()) takes this as an opaque octet string and wraps
+ * it into the top-level NGAP PDU, which is why the MB-SMF has to encode it. */
+ogs_pkbuf_t *ngap_build_multicast_session_activation_request_transfer(ogs_tmgi_t *tmgi)
+{
+    NGAP_MulticastSessionActivationRequestTransfer_t message;
+
+    ogs_assert(tmgi);
+
+    ogs_debug("MulticastSessionActivationRequestTransfer");
+    memset(&message, 0, sizeof(message));
+
+    ogs_ngap_5gs_tmgi_to_ASN(tmgi, &message.mBS_SessionID.tMGI);
+
+    return ogs_asn_encode(
+            &asn_DEF_NGAP_MulticastSessionActivationRequestTransfer, &message);
+}
