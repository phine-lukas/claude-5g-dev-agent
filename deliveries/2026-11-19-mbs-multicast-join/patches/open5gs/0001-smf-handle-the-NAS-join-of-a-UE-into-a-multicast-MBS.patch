--- a/src/smf/context.h
+++ b/src/smf/context.h
@@ -657,6 +657,18 @@ typedef struct smf_mbs_dl_tunnel_s {
     uint16_t unicast_params_id; /* MBS Unicast Parameters ID, from 1 */
 } smf_mbs_dl_tunnel_t;
 
+/* A UE that has joined a multicast MBS session (TS 23.247 V18.8.0 cl. 7.2.1.3 step 5: the SMF informs
+ * "the NG-RAN about the relation between the Multicast MBS Session Context and the UE's PDU Session
+ * context"). One entry per associated PDU session, so a UE with two PDU sessions joined to the same
+ * session has two. The PDU session is held by id, not by pointer: it can be released while the MBS
+ * session lives on, and smf_mbs_member_find() drops an entry whose session is gone. */
+typedef struct smf_mbs_member_s {
+    ogs_lnode_t lnode;
+
+    ogs_pool_id_t sess_id;      /* the associated PDU session (smf_sess_t) */
+    uint8_t psi;                /* its PDU session identity, kept for logs after the session is gone */
+} smf_mbs_member_t;
+
 /* A status subscription of an MBS session (TS 29.532 V18.6.0 cl. 5.3.2.6, StatusSubscribe), the resource
  * /mbs-sessions/subscriptions/{subscriptionId} */
 #define SMF_MBS_EVENT(type) ((uint32_t)1 << (type))
@@ -727,6 +739,14 @@ typedef struct smf_mbs_sess_s {
     OpenAPI_mbs_session_activity_status_e activity_status;
     const char *state;
 
+    /* The UEs that joined this multicast MBS session: smf_mbs_member_t entries. Empty for a broadcast
+     * session, which has no membership at all (TS 23.247 V18.8.0 cl. 4.1). */
+    ogs_list_t member_list;
+
+    /* The RAN has been told to activate this session (a MulticastSessionActivationRequest was relayed
+     * through the AMF). Set when the first member joins, so later joiners do not re-activate it. */
+    bool ran_activated;
+
     ogs_pfcp_sess_t pfcp;   /* PFCP session context */
 
     ogs_pool_id_t *smf_n4mb_seid_node; /* A node of SMF-N4mb-SEID */
@@ -1006,6 +1026,13 @@ smf_mbs_sess_t *smf_mbs_sess_find_by_id(ogs_pool_id_t id);
 smf_mbs_sess_t *smf_mbs_sess_find_by_mbs_session_ref(char *mbs_session_ref);
 smf_mbs_sess_t *smf_mbs_sess_find_by_seid(uint64_t seid);
 smf_mbs_sess_t *smf_mbs_sess_find_by_tmgi(ogs_tmgi_t *tmgi_to_find);
+
+smf_mbs_member_t *smf_mbs_member_find(smf_mbs_sess_t *mbs_sess, const smf_sess_t *sess);
+smf_mbs_member_t *smf_mbs_member_add(smf_mbs_sess_t *mbs_sess, const smf_sess_t *sess);
+void smf_mbs_member_remove(smf_mbs_sess_t *mbs_sess, smf_mbs_member_t *member);
+void smf_mbs_member_remove_all(smf_mbs_sess_t *mbs_sess);
+/* Drop \p sess from every multicast MBS session it joined; called when the PDU session goes away. */
+void smf_mbs_member_remove_by_sess(const smf_sess_t *sess);
 smf_mbs_amf_t *smf_mbs_sess_amf_add(smf_mbs_sess_t *mbs_sess);
 smf_mbs_amf_t *smf_mbs_sess_amf_find(smf_mbs_sess_t *mbs_sess, uint32_t id);
 void smf_mbs_sess_amf_remove(smf_mbs_sess_t *mbs_sess, smf_mbs_amf_t *amf);
