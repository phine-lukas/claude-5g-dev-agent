+/*
+ * The Requested MBS container, TS 24.501 V18.14.0 cl. 9.11.4.30. One TMGI entry is 7 octets: the
+ * octet carrying the ID type and the operation, then the 6-octet TMGI.
+ */
+static void test_requested_mbs_container(void)
+{
+    smf_mbs_request_t out[SMF_MBS_MAX_REQUESTS];
+    int n;
+
+    /* one join of TMGI 0xabcdef / PLMN 999-70 */
+    {
+        const uint8_t buf[] = {
+            0x05,                                       /* ID type 01 (TMGI), operation 01 (join) */
+            0xab, 0xcd, 0xef, 0x99, 0xf9, 0x07,
+        };
+        n = smf_mbs_parse_requested_container(buf, sizeof(buf), out, SMF_MBS_MAX_REQUESTS);
+        CHECK(n == 1);
+        if (n == 1) {
+            CHECK(out[0].operation == SMF_MBS_OP_JOIN);
+            CHECK(out[0].session_id_type == SMF_MBS_SESSION_ID_TMGI);
+            CHECK(memcmp(out[0].tmgi, buf + 1, SMF_MBS_TMGI_LEN) == 0);
+        }
+    }
+
+    /* two entries, the second a leave: both are reported, the caller decides what to do with them */
+    {
+        const uint8_t buf[] = {
+            0x05, 0x00, 0x00, 0x01, 0x99, 0xf9, 0x07,
+            0x09, 0x00, 0x00, 0x02, 0x99, 0xf9, 0x07,   /* operation 10 (leave) */
+        };
+        n = smf_mbs_parse_requested_container(buf, sizeof(buf), out, SMF_MBS_MAX_REQUESTS);
+        CHECK(n == 2);
+        if (n == 2) {
+            CHECK(out[0].operation == SMF_MBS_OP_JOIN);
+            CHECK(out[1].operation == SMF_MBS_OP_LEAVE);
+            CHECK(out[1].tmgi[2] == 0x02);
+        }
+    }
+
+    /* the SSM forms are 8 and 32 octets of session ID and are skipped over, not misparsed */
+    {
+        const uint8_t buf[] = {
+            0x06,                                       /* ID type 10 (SSM IPv4), join */
+            192, 168, 77, 20, 239, 0, 0, 25,
+            0x05, 0x00, 0x00, 0x03, 0x99, 0xf9, 0x07,   /* a TMGI join after it */
+        };
+        n = smf_mbs_parse_requested_container(buf, sizeof(buf), out, SMF_MBS_MAX_REQUESTS);
+        CHECK(n == 2);
+        if (n == 2) {
+            CHECK(out[0].session_id_type == SMF_MBS_SESSION_ID_SSM_IPV4);
+            CHECK(out[1].session_id_type == SMF_MBS_SESSION_ID_TMGI);
+            CHECK(out[1].tmgi[2] == 0x03);
+        }
+    }
+
+    /* a truncated entry is a malformed IE, not a short read */
+    {
+        const uint8_t buf[] = { 0x05, 0xab, 0xcd, 0xef };
+        CHECK(smf_mbs_parse_requested_container(buf, sizeof(buf), out, SMF_MBS_MAX_REQUESTS) == -1);
+    }
+
+    /* "All other values are reserved": the entry has no known length, so the IE cannot be walked */
+    {
+        const uint8_t buf[] = { 0x04, 0xab, 0xcd, 0xef, 0x99, 0xf9, 0x07 };
+        CHECK(smf_mbs_parse_requested_container(buf, sizeof(buf), out, SMF_MBS_MAX_REQUESTS) == -1);
+    }
+    {
+        const uint8_t buf[] = { 0x0d, 0xab, 0xcd, 0xef, 0x99, 0xf9, 0x07 }; /* operation 11 */
+        CHECK(smf_mbs_parse_requested_container(buf, sizeof(buf), out, SMF_MBS_MAX_REQUESTS) == -1);
+    }
+
+    /* an empty container has no entries and is not an error */
+    CHECK(smf_mbs_parse_requested_container((const uint8_t *)"", 0, out, SMF_MBS_MAX_REQUESTS) == 0);
+}
+
+/*
+ * The Received MBS container, TS 24.501 V18.14.0 cl. 9.11.4.31. Octet 4 is
+ * rejection cause (bits 6-8) | MSAI (bits 4-5) | MD (bits 1-3); octet 5 is all zero here because no
+ * optional field is produced; then the TMGI.
+ */
+static void test_received_mbs_container(void)
+{
+    smf_mbs_result_t results[2];
+    uint8_t buf[64];
+    int len;
+
+    memset(results, 0, sizeof(results));
+    memcpy(results[0].tmgi, "\xab\xcd\xef\x99\xf9\x07", SMF_MBS_TMGI_LEN);
+    results[0].decision = SMF_MBS_DECISION_JOIN_ACCEPTED;
+
+    len = smf_mbs_build_received_container(buf, sizeof(buf), results, 1);
+    CHECK(len == 8);
+    if (len == 8) {
+        CHECK(buf[0] == 0x02);          /* MD = 010, MSAI = 00, no rejection cause */
+        CHECK(buf[1] == 0x00);
+        CHECK(memcmp(buf + 2, results[0].tmgi, SMF_MBS_TMGI_LEN) == 0);
+    }
+
+    /* a rejection carries its cause in bits 6 to 8 */
+    results[0].decision = SMF_MBS_DECISION_JOIN_REJECTED;
+    results[0].reject_cause = SMF_MBS_REJECT_CONTEXT_NOT_FOUND;     /* 101 */
+    len = smf_mbs_build_received_container(buf, sizeof(buf), results, 1);
+    CHECK(len == 8);
+    if (len == 8)
+        CHECK(buf[0] == ((5 << 5) | 3));
+
+    /* an accepted entry has those bits spare even when the caller left a cause in the struct */
+    results[0].decision = SMF_MBS_DECISION_JOIN_ACCEPTED;
+    len = smf_mbs_build_received_container(buf, sizeof(buf), results, 1);
+    CHECK(len == 8);
+    if (len == 8)
+        CHECK(buf[0] == 0x02);
+
+    /* two entries are concatenated, nothing between them */
+    memcpy(results[1].tmgi, "\x00\x00\x02\x99\xf9\x07", SMF_MBS_TMGI_LEN);
+    results[1].decision = SMF_MBS_DECISION_JOIN_REJECTED;
+    results[1].reject_cause = SMF_MBS_REJECT_NOT_AUTHORIZED;        /* 010 */
+    len = smf_mbs_build_received_container(buf, sizeof(buf), results, 2);
+    CHECK(len == 16);
+    if (len == 16) {
+        CHECK(buf[8] == ((2 << 5) | 3));
+        CHECK(memcmp(buf + 10, results[1].tmgi, SMF_MBS_TMGI_LEN) == 0);
+    }
+
+    /* it never writes past the buffer it was given */
+    CHECK(smf_mbs_build_received_container(buf, 15, results, 2) == -1);
+}
+
+/* The two TMGI encodings agree: what smf_mbs_tmgi_to_octets() produces for NAS is what
+ * ogs_ngap_5gs_tmgi_to_ASN() produces for NGAP, which is what lets a TMGI read off a NAS container be
+ * compared with a session's TMGI without converting either. */
+static void test_tmgi_octets_match_ngap(void)
+{
+    ogs_tmgi_t tmgi;
+    uint8_t octets[SMF_MBS_TMGI_LEN];
+    NGAP_TMGI_t asn;
+
+    memset(&tmgi, 0, sizeof(tmgi));
+    memset(&asn, 0, sizeof(asn));
+    tmgi.mbs_service_id = ogs_strdup("Abcdef");
+    ogs_plmn_id_build(&tmgi.plmn_id, 999, 70, 2);
+
+    CHECK(smf_mbs_tmgi_to_octets(&tmgi, octets) == true);
+    ogs_ngap_5gs_tmgi_to_ASN(&tmgi, &asn);
+    CHECK(((OCTET_STRING_t *)&asn)->size == SMF_MBS_TMGI_LEN);
+    CHECK(memcmp(octets, ((OCTET_STRING_t *)&asn)->buf, SMF_MBS_TMGI_LEN) == 0);
+    /* hexadecimal of either case, as TS 29.571 Tmgi.mbsServiceId allows */
+    CHECK(octets[0] == 0xab && octets[1] == 0xcd && octets[2] == 0xef);
+
+    ASN_STRUCT_FREE_CONTENTS_ONLY(asn_DEF_NGAP_TMGI, &asn);
+
+    /* a service id that is not 6 hex characters is refused rather than half-converted */
+    ogs_free(tmgi.mbs_service_id);
+    tmgi.mbs_service_id = ogs_strdup("abc");
+    CHECK(smf_mbs_tmgi_to_octets(&tmgi, octets) == false);
+    ogs_free(tmgi.mbs_service_id);
+    tmgi.mbs_service_id = NULL;
+    CHECK(smf_mbs_tmgi_to_octets(&tmgi, octets) == false);
+}
+
+/* The per-UE N2 of a join: a PDU Session Resource Modify Request Transfer whose only IE is
+ * id-MBSSessionSetuporModifyRequestList (TS 38.413 V17.10.0, ProtocolIE-ID 319), one item per MBS
+ * session, each carrying the 6-octet TMGI. Checked by decoding what was encoded, so the test fails if
+ * the IE is given the wrong id, criticality or ASN.1 shape. */
+static void test_modify_request_transfer_mbs(void)
+{
+    const uint8_t tmgi[2][6] = {
+        { 0xab, 0xcd, 0xef, 0x99, 0xf9, 0x07 },
+        { 0x00, 0x00, 0x02, 0x99, 0xf9, 0x07 },
+    };
+    ogs_pkbuf_t *pkbuf = NULL;
+    NGAP_PDUSessionResourceModifyRequestTransfer_t *decoded = NULL;
+    asn_dec_rval_t rv;
+
+    pkbuf = ngap_build_pdu_session_resource_modify_request_transfer_mbs(tmgi, 2);
+    CHECK(pkbuf != NULL);
+    if (!pkbuf) return;
+
+    rv = aper_decode(NULL, &asn_DEF_NGAP_PDUSessionResourceModifyRequestTransfer,
+            (void **)&decoded, pkbuf->data, pkbuf->len, 0, 0);
+    CHECK(rv.code == RC_OK);
+    if (rv.code == RC_OK && decoded) {
+        CHECK(decoded->protocolIEs.list.count == 1);
+        if (decoded->protocolIEs.list.count == 1) {
+            NGAP_PDUSessionResourceModifyRequestTransferIEs_t *ie =
+                decoded->protocolIEs.list.array[0];
+            CHECK(ie->id == NGAP_ProtocolIE_ID_id_MBSSessionSetuporModifyRequestList);
+            CHECK(ie->criticality == NGAP_Criticality_ignore);
+            CHECK(ie->value.present ==
+                NGAP_PDUSessionResourceModifyRequestTransferIEs__value_PR_MBSSessionSetuporModifyRequestList);
+            CHECK(ie->value.choice.MBSSessionSetuporModifyRequestList.list.count == 2);
+            if (ie->value.choice.MBSSessionSetuporModifyRequestList.list.count == 2) {
+                NGAP_MBSSessionSetuporModifyRequestItem_t *item =
+                    ie->value.choice.MBSSessionSetuporModifyRequestList.list.array[0];
+                CHECK(item->mBS_SessionID.tMGI.size == 6);
+                CHECK(memcmp(item->mBS_SessionID.tMGI.buf, tmgi[0], 6) == 0);
+                item = ie->value.choice.MBSSessionSetuporModifyRequestList.list.array[1];
+                CHECK(memcmp(item->mBS_SessionID.tMGI.buf, tmgi[1], 6) == 0);
+            }
+        }
+    }
+    ASN_STRUCT_FREE(asn_DEF_NGAP_PDUSessionResourceModifyRequestTransfer, decoded);
+    ogs_pkbuf_free(pkbuf);
+}
+
+/* The non-UE N2 of a join: MulticastSessionActivationRequestTransfer is just the MBS Session ID
+ * again. The AMF wraps this into the MULTICAST SESSION ACTIVATION REQUEST, so if the MB-SMF encodes
+ * the wrong thing here the gNB sees a well-formed PDU with an undecodable transfer. */
+static void test_multicast_activation_transfer(void)
+{
+    ogs_tmgi_t tmgi;
+    ogs_pkbuf_t *pkbuf = NULL;
+    NGAP_MulticastSessionActivationRequestTransfer_t *decoded = NULL;
+    asn_dec_rval_t rv;
+    uint8_t expected[SMF_MBS_TMGI_LEN];
+
+    memset(&tmgi, 0, sizeof(tmgi));
+    tmgi.mbs_service_id = ogs_strdup("abcdef");
+    ogs_plmn_id_build(&tmgi.plmn_id, 999, 70, 2);
+    CHECK(smf_mbs_tmgi_to_octets(&tmgi, expected) == true);
+
+    pkbuf = ngap_build_multicast_session_activation_request_transfer(&tmgi);
+    CHECK(pkbuf != NULL);
+    if (pkbuf) {
+        rv = aper_decode(NULL, &asn_DEF_NGAP_MulticastSessionActivationRequestTransfer,
+                (void **)&decoded, pkbuf->data, pkbuf->len, 0, 0);
+        CHECK(rv.code == RC_OK);
+        if (rv.code == RC_OK && decoded) {
+            CHECK(decoded->mBS_SessionID.tMGI.size == SMF_MBS_TMGI_LEN);
+            CHECK(memcmp(decoded->mBS_SessionID.tMGI.buf, expected, SMF_MBS_TMGI_LEN) == 0);
+        }
+        ASN_STRUCT_FREE(asn_DEF_NGAP_MulticastSessionActivationRequestTransfer, decoded);
+        ogs_pkbuf_free(pkbuf);
+    }
+
+    ogs_free(tmgi.mbs_service_id);
+}
